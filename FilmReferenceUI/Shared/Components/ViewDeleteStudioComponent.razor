<MudCardContent>

    <MudGrid>

        <!-- LEFT COLUMN: Studio details -->
        <MudItem xs="12" md="8">

            <MudStack Spacing="1">

                @if (!string.IsNullOrWhiteSpace(StudioModel.Description))
                {
                    <MudText Typo="Typo.h6" Class="mb-3">
                        @StudioModel.Description
                    </MudText>
                }

                @if (!string.IsNullOrWhiteSpace(StudioModel.Notes))
                {
                    <MudText Typo="Typo.body1" class="mb-3">
                        @StudioModel.Notes
                    </MudText>
                }

            </MudStack>

        </MudItem>

        <!-- RIGHT COLUMN: Studio logo -->
        <MudItem xs="12" md="4"
                 Class="d-flex justify-center align-center">

            <ViewImageComponent ImageData="StudioModel.Logo"
                                    ImageTitle="@StudioModel.Name" />

        </MudItem>

    </MudGrid>

</MudCardContent>
