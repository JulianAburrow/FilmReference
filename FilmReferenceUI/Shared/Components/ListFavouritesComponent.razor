@inherits FavouritesBasePageClass

<MudTabs Elevation="2" Rounded="true" ApplyEffectsToContainer="true">

    @foreach (var group in _groupedFavourites)
    {
        var entityTypeId = group.Key;
        var items = group.Value;
        var entityTypeName = ((FavouriteEntityEnum)entityTypeId).ToString();

        <MudTabPanel Text="@entityTypeName">

            @{
                bool showButton = items.Count > 1;
            }

            <div class="my-4"></div>

            @{
                var count = FavouriteDisplayModels.Count();
                var word = count == 1 ? "favourite" : "favourites";
            }
            <div class="d-flex align-center gap-3">
                <MudText Typo="Typo.subtitle1" Style="margin-left:5px;">@count @word found</MudText>

                <MudButton Variant="Variant.Outlined"
                           Color="Color.Default"
                           Size="Size.Small"
                           StartIcon="@Icons.Material.Filled.SwapVert"
                           Disabled="@(items.Count <= 1)"
                           Style=@($"visibility:{(showButton ? "visible" : "hidden")}")
                           OnClick="(() => ResortList(entityTypeName))">
                    Reverse Sort
                </MudButton>
            </div>


            

            <MudDivider Class="my-8" />

            <MudGrid Justify="Justify.FlexStart" Spacing="2">
                @foreach (var favouriteDisplayModel in items)
                {
                    <MudItem xs="12" sm="6" md="4" lg="3" Class="equal-height-item">
                        <FavouriteComponent Favourite="favouriteDisplayModel" OnRemoved="HandleRemoved" />
                    </MudItem>
                }
            </MudGrid>

        </MudTabPanel>
    }

</MudTabs>
