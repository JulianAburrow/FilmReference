<MudCardContent>

    <MudGrid>

        <!-- LEFT COLUMN: Film details -->
        <MudItem xs="12" md="8">

            <MudStack Spacing="1">

                <!-- GENRE -->
                
                    <MudLink Href="@($"/genre/view/{FilmModel.GenreId}")"
                             Class="no-underline">
                        <ViewImageThumbnailComponent
                            ImageData="FilmModel.Genre.Logo"
                            ImageTitle="@FilmModel.Genre.Name" />
                    </MudLink>

                    <MudText>
                        <b>Genre:</b>
                        <MudLink Href="@($"/genre/view/{FilmModel.GenreId}")"
                                 Class="no-underline">
                            @FilmModel.Genre.Name
                        </MudLink>
                    </MudText>

                <!-- STUDIO -->
                    <MudLink Href="@($"/studio/view/{FilmModel.StudioId}")"
                             Class="no-underline">
                        <ViewImageThumbnailComponent
                            ImageData="FilmModel.Studio.Logo"
                            ImageTitle="@FilmModel.Studio.Name" />
                    </MudLink>

                    <MudText>
                        <b>Studio:</b>
                        <MudLink Href="@($"/studio/view/{FilmModel.StudioId}")"
                                 Class="no-underline">
                            @FilmModel.Studio.Name
                        </MudLink>
                    </MudText>

                <!-- DIRECTOR (text only, no image) -->
                    <MudText>
                        <b>Director:</b>
                        <MudLink Href="@($"/person/view/{FilmModel.Director.PersonId}")"
                                 Class="no-underline">
                            @FilmModel.Director.FirstName @FilmModel.Director.LastName
                        </MudLink>
                    </MudText>

                <MudDivider Class="my-4" />

                <!-- Description -->
                @if (!string.IsNullOrWhiteSpace(FilmModel.Description))
                {
                    <MudText Typo="Typo.body1" Class="mb-3">
                        @FilmModel.Description
                    </MudText>
                }

            </MudStack>

        </MudItem>

        <!-- RIGHT COLUMN: Box cover -->
        <MudItem xs="12" md="4"
                 Class="d-flex justify-center align-center">
            <ViewImageComponent ImageData="FilmModel.BoxCover"
                                ImageTitle="@FilmModel.Name" />
        </MudItem>

    </MudGrid>

</MudCardContent>
