@inherits PeopleBasePageClass

<MudCardContent>
    <MudTextField Label="First Name" @bind-Value="PersonDisplayModel.FirstName" AutoFocus OnlyValidateIfDirty="true" />
    <MudTextField Label="Last Name" @bind-Value="PersonDisplayModel.LastName" />
    <MudTextField Label="Description" @bind-Value="PersonDisplayModel.Description" Lines="3" />
    <MudCheckBox Label="Cast Member" @bind-Value="PersonDisplayModel.IsCastMember" />
    <MudCheckBox Label="Director" @bind-Value="PersonDisplayModel.IsDirector" />
    <br />
    <ViewImageComponent ImageData="PersonDisplayModel.Picture" ImageTitle=@($"{PersonDisplayModel.FirstName} {PersonDisplayModel.LastName} Photo") />
    <br />
    <MudFileUpload T="IBrowserFile" FilesChanged="LocalUploadImage" Accept="image/*">
        <ActivatorContent>
            <MudButton HtmlTag="label"
                       Variant="Variant.Filled"
                       Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.FileUpload">
                Upload File
            </MudButton>
        </ActivatorContent>
	</MudFileUpload>
    @if (PersonDisplayModel.Picture is not null)
    {
        <br />
        @ImageName
        <br />
        <MudButton HtmlTag="label"
                   OnClick="LocalRemoveImage"
                   Variant="Variant.Filled"
                   Color="Color.Error">
            Remove Image
        </MudButton>
    }
</MudCardContent>
