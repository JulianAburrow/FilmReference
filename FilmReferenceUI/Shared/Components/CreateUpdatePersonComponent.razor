@inherits PeopleBasePageClass

<MudCardContent>

    <MudGrid>

        <!-- LEFT COLUMN: Form fields -->
        <MudItem xs="12" md="8">

            <MudTextField Label="First Name"
                          @bind-Value="PersonDisplayModel.FirstName"
                          AutoFocus
                          OnlyValidateIfDirty="true" />

            <MudTextField Label="Last Name"
                          @bind-Value="PersonDisplayModel.LastName" />

            <MudTextField Label="Description"
                          @bind-Value="PersonDisplayModel.Description"
                          Lines="3" />

            <MudGrid>
                <MudItem xs="6">
                    <MudCheckBox Label="Cast Member"
                                 @bind-Value="PersonDisplayModel.IsCastMember" />
                </MudItem>

                <MudItem xs="6">
                    <MudCheckBox Label="Director"
                                 @bind-Value="PersonDisplayModel.IsDirector" />
                </MudItem>
            </MudGrid>

            <MudTextField Label="Date Of Birth"
                          @bind-Value="PersonDisplayModel.DateOfBirth"
                          Format="dd/MM/yyyy" />

            <MudTextField Label="Date Of Death"
                          @bind-Value="PersonDisplayModel.DateOfDeath"
                          Format="dd/MM/yyyy" />
            
            <br />

            <MudFileUpload T="IBrowserFile"
                           FilesChanged="LocalUploadImage"
                           Accept="image/*">
                <ActivatorContent>
                    <MudButton HtmlTag="label"
                               Variant="Variant.Filled"
                               Color="Color.Primary"
                               StartIcon="@Icons.Material.Filled.FileUpload">
                        Upload File
                    </MudButton>
                </ActivatorContent>
            </MudFileUpload>

            @if (PersonDisplayModel.Picture is not null)
            {
                <MudText Class="mt-2 mb-1">@ImageName</MudText>

                <MudButton Variant="Variant.Filled"
                           Color="Color.Error"
                           OnClick="LocalRemoveImage">
                    Remove Image
                </MudButton>
            }

        </MudItem>

        <!-- RIGHT COLUMN: Image -->
        <MudItem xs="12" md="4"
                 Class="d-flex justify-center align-center">
            <ViewImageComponent ImageData="PersonDisplayModel.Picture"
                                ImageTitle="@($"{PersonDisplayModel.FirstName} {PersonDisplayModel.LastName} Photo")" />
        </MudItem>

    </MudGrid>

</MudCardContent>
