<MudCard Class="ma-2 pa-2" Style="max-width: 375px; width: 100%;">
    <MudCardHeader>
        <CardHeaderContent>
            <MudText Typo="Typo.overline" Color="Color.Secondary">Featured Person</MudText>
            <MudText Typo="Typo.h6">@RandomPerson.FirstName @RandomPerson.LastName</MudText>
            <MudText Typo="Typo.caption" Color="Color.Secondary">
                @RandomPerson.FilmCount @(RandomPerson.FilmCount == 1 ? "film" : "films")
            </MudText>
        </CardHeaderContent>
    </MudCardHeader>
    <MudCardContent Class="pt-0">
        <MudLink Href="@($"/person/view/{RandomPerson.PersonId}")" Class="no-underline d-block">
            <ViewImageComponent ImageData="@RandomPerson.Picture"
                                ImageTitle="@($"{RandomPerson.FirstName} {RandomPerson.LastName}")" />
        </MudLink>
    </MudCardContent>
    <MudCardActions>
        <MudButton Variant="Variant.Filled"
                   Color="Color.Primary"
                   Size="Size.Small"
                   Href="@($"/person/view/{RandomPerson.PersonId}")">
            View
        </MudButton>
    </MudCardActions>
</MudCard>
