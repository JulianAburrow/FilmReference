<MudCard Class="ma-2 pa-2" Style="width: 100%; max-width: 350px;">
    <MudCardHeader>
        <MudText Typo="Typo.h6">@Studio.Name</MudText>
    </MudCardHeader>

    <MudCardContent>
        <MudText>@Studio.Films.Count @(Studio.Films.Count == 1 ? "film" : "films")</MudText>
        <br />
        <MudButton Variant="Variant.Text"
                   Color="Color.Primary"
                   Href="@($"/studio/view/{Studio.StudioId}")"
                   Class="p-0">
            <ViewImageComponent ImageData="@Studio.Logo"
                                ImageTitle="@($"{Studio.Name} Logo")" />
        </MudButton>
    </MudCardContent>

    <MudCardActions Class="d-flex flex-wrap" Style="gap: 8px;">
        <MudButton Variant="Variant.Filled" Color="Color.Primary" Href=@($"/studio/view/{Studio.StudioId}")>
            View
        </MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" Href=@($"/studio/edit/{Studio.StudioId}")>
            Edit
        </MudButton>
        @if (Studio.Films.Count == 0)
        {            
            <MudButton Variant="Variant.Filled" Color="Color.Error" Href=@($"/studio/delete/{Studio.StudioId}")>
                Delete
            </MudButton>
        }
    </MudCardActions>
</MudCard>