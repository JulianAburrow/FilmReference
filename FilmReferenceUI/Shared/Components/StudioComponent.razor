<MudCard Class="ma-2" Style="width: 100%;">
    <MudCardHeader>
        <CardHeaderContent>
            <MudText Typo="Typo.h6">@Studio.Name</MudText>
            <MudText Typo="Typo.caption" Color="Color.Secondary">
                @Studio.Films.Count @(Studio.Films.Count == 1 ? "film" : "films")
            </MudText>
        </CardHeaderContent>
    </MudCardHeader>
    <MudCardContent Class="pt-0">
        @{
            var imageTitle = string.IsNullOrWhiteSpace(Studio.Description)
                ? Studio.Name
                : $"{Studio.Name} - {Studio.Description}";
        }
        <MudLink Href="@($"/studio/view/{Studio.StudioId}")" Class="no-underline d-block">
            <ViewImageComponent ImageData="Studio.Logo" ImageTitle="@imageTitle" />
        </MudLink>
    </MudCardContent>
    <MudCardActions Class="gap-2">
        <MudButton Variant="Variant.Filled"
                   Color="Color.Primary"
                   Size="Size.Small"
                   Href="@($"/studio/view/{Studio.StudioId}")">
            View
        </MudButton>
        <MudButton Variant="Variant.Outlined"
                   Color="Color.Primary"
                   Size="Size.Small"
                   Href="@($"/studio/edit/{Studio.StudioId}")">
            Edit
        </MudButton>
        @if (Studio.Films.Count == 0)
        {
            <MudButton Variant="Variant.Outlined"
                       Color="Color.Error"
                       Size="Size.Small"
                       Href="@($"/studio/delete/{Studio.StudioId}")">
                Delete
            </MudButton>
        }
    </MudCardActions>
</MudCard>
