<MudCardContent>

    <MudGrid>

        <!-- LEFT COLUMN: Genre details -->
        <MudItem xs="12" md="8">

            <MudStack Spacing="2">

                @if (!string.IsNullOrWhiteSpace(GenreModel.Description))
                {
                    <MudText Typo="Typo.body1">
                        @GenreModel.Description
                    </MudText>
                }

            </MudStack>

        </MudItem>

        <!-- RIGHT COLUMN: Genre logo -->
        <MudItem xs="12" md="4"
                 Class="d-flex justify-center align-center">

            
            <ViewImageComponent ImageData="@GenreModel.Logo"
                                    ImageTitle="@GenreModel.Name" />

        </MudItem>

    </MudGrid>

</MudCardContent>
