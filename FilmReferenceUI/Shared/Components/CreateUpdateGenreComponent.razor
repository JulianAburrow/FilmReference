@inherits GenresBasePageClass

<MudCardContent>

    <MudGrid>

        <!-- LEFT COLUMN: Genre fields -->
        <MudItem xs="12" md="8">

            <MudTextField Label="Name"
                          @bind-Value="GenreDisplayModel.Name"
                          AutoFocus
                          OnlyValidateIfDirty="true" />

            <MudTextField Label="Description"
                          @bind-Value="GenreDisplayModel.Description" />

            <br />

            <MudFileUpload T="IBrowserFile"
                           FilesChanged="LocalUploadImage"
                           Accept="image/*">
                <ActivatorContent>
                    <MudButton HtmlTag="label"
                               Variant="Variant.Filled"
                               Color="Color.Primary"
                               StartIcon="@Icons.Material.Filled.FileUpload">
                        Upload File
                    </MudButton>
                </ActivatorContent>
            </MudFileUpload>

            @if (GenreDisplayModel.Logo is not null)
            {
                <MudText Class="mt-2 mb-1">@ImageName</MudText>

                <MudButton HtmlTag="label"
                           OnClick="LocalRemoveImage"
                           Variant="Variant.Filled"
                           Color="Color.Error">
                    Remove Image
                </MudButton>
            }

        </MudItem>

        <!-- RIGHT COLUMN: Genre logo -->
        <MudItem xs="12" md="4"
                 Class="d-flex justify-center align-center">

            @if (GenreDisplayModel.Logo is not null)
            {
                <ViewImageComponent ImageData="GenreDisplayModel.Logo"
                                    ImageTitle="@($"{GenreDisplayModel.Name} Logo")" />
            }

        </MudItem>

    </MudGrid>

</MudCardContent>
