@using MudBlazor

<MudTable Items="@FilmModels"
          SortLabel="SortBy"
          Hover
          RowsPerPage="10"
          FixedHeader>
    <HeaderContent>
        <MudTh title="Sort by Name">
            <MudTableSortLabel SortBy="new Func<FilmModel, object>(x => x.Name)">
                Name
            </MudTableSortLabel>
        </MudTh>
        <MudTh title="Sort by Studio">
            <MudTableSortLabel SortBy="new Func<FilmModel, object>(x => x.Studio.Name)">
                Studio
            </MudTableSortLabel>
        </MudTh>
        <MudTh title="Sort by Genre">
            <MudTableSortLabel SortBy="new Func<FilmModel, object>(x => x.Genre.Name)">
                Genre
            </MudTableSortLabel>
        </MudTh>
        <MudTh></MudTh>
    </HeaderContent>
    <RowTemplate>
        <MudTd>@context.Name</MudTd>
        <MudTd>@context.Studio.Name</MudTd>
        <MudTd>@context.Genre.Name</MudTd>
        <MudTd>
            <a class="btn btn-primary" href="/film/view/@context.FilmId">View</a>
            &nbsp;
            <a class="btn btn-primary" href="/film/edit/@context.FilmId">Edit</a>
            &nbsp;
            <a class="btn btn-danger" href="/film/delete/@context.FilmId">Delete</a>
        </MudTd>
    </RowTemplate>
    <PagerContent>
        <MudTablePager PageSizeOptions="new int[] { 5, 10, 25, 50, 100, int.MaxValue }" />
    </PagerContent>
</MudTable>
