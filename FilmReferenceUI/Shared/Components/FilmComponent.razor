<MudCard Class="ma-2" Style="width: 100%;">
    <MudCardHeader>
        <CardHeaderContent>
            <MudText Typo="Typo.h6">@Film.Name</MudText>
            <MudText Typo="Typo.caption" Color="Color.Secondary">
                <MudLink Href="@($"/studio/view/{Film.StudioId}")" Color="Color.Secondary">@Film.Studio?.Name</MudLink>
                &bull;
                <MudLink Href="@($"/genre/view/{Film.GenreId}")" Color="Color.Secondary">@Film.Genre?.Name</MudLink>
            </MudText>
        </CardHeaderContent>
    </MudCardHeader>
    <MudCardContent Class="pt-0">
        @{
            var imageTitle = $"{Film.Name} - {Film.Description}";
        }
        <MudLink Href="@($"/film/view/{Film.FilmId}")" Class="no-underline d-block">
            <ViewImageComponent ImageData="Film.BoxCover" ImageTitle="@imageTitle" />
        </MudLink>
    </MudCardContent>
    <MudCardActions Class="gap-2">
        <MudButton Variant="Variant.Filled"
                   Color="Color.Primary"
                   Size="Size.Small"
                   Href="@($"/film/view/{Film.FilmId}")">
            View
        </MudButton>
        <MudButton Variant="Variant.Outlined"
                   Color="Color.Primary"
                   Size="Size.Small"
                   Href="@($"/film/edit/{Film.FilmId}")">
            Edit
        </MudButton>
    </MudCardActions>
</MudCard>
