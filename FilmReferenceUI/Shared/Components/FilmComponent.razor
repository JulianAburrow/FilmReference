<MudCard Class="ma-2 pa-2" Style="width: 100%; max-width: 350px;">
    <MudCardHeader>
        <MudText Typo="Typo.h6">@Film.Name</MudText>
    </MudCardHeader>
    <MudCardContent>
        <MudText><b>Studio</b>: <MudLink Href=@($"/studio/view/{Film.StudioId}")>@Film.Studio?.Name</MudLink></MudText>
        <MudText><b>Genre</b>: @Film.Genre?.Name</MudText>
        <MudText><b>Description</b>: @Film.Description</MudText>
        <br />
        <ViewImageComponent ImageData="@Film.BoxCover" ImageTitle="@($"{Film.Name} Box Cover")" />
    </MudCardContent>
    <MudCardActions Class="d-flex flex-wrap" Style="gap: 8px;">
        <MudButton Variant="Variant.Filled" Color="Color.Primary" Href=@($"/film/view/{Film.FilmId}")>
            View
        </MudButton>
    </MudCardActions>
</MudCard>