<MudCard Class="ma-2 pa-2" Style="width: 100%; max-width: 350px;">
    <MudCardHeader>
        <MudText Typo="Typo.h6">@Film.Name</MudText>
    </MudCardHeader>
    <MudCardContent>
        <MudText><b>Studio</b>: <MudLink Href=@($"/studio/view/{Film.StudioId}")>@Film.Studio?.Name</MudLink></MudText>
        <MudText><b>Genre</b>: <MudLink Href=@($"/genre/view/{Film.GenreId}")>@Film.Genre?.Name</MudLink></MudText>
        <br />
        @{
            var ImageTitle = $"{Film.Name} - {Film.Description}";
        }
        <MudButton Variant="Variant.Text"
                   Color="Color.Primary"
                   Href="@($"/film/view/{Film.FilmId}")"
                   Class="p-0">
            <ViewImageComponent ImageData="Film.BoxCover"
                                ImageTitle="@ImageTitle" />
        </MudButton>
    </MudCardContent>
    <MudCardActions Class="d-flex flex-wrap" Style="gap: 8px;">
        <MudButton Variant="Variant.Filled" Color="Color.Primary" Href=@($"/film/view/{Film.FilmId}")>
            View
        </MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" Href=@($"/film/edit/{Film.FilmId}")>
            Edit
        </MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Error" Href=@($"/film/delete/{Film.FilmId}")>
            Delete
        </MudButton>
    </MudCardActions>
</MudCard>