<MudStack Justify="Justify.FlexStart">
	@if (ImageData is not null)
	{
		<div class="image-wrapper">
			<MudImage src="@(ImageHelper.ImageSource(ImageData))"
					  title="@ImageTitle"
					  Elevation="25"
					  Class="rounded-lg"
					  Style="width: auto !important;
						height:auto;
						object-fit:contain;" />
		</div>
	}
	else
	{
		<MudField>No Image Available</MudField>
	}
</MudStack>