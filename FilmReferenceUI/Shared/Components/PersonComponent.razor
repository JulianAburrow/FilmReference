<MudCard Class="ma-2 pa-2" Style="width: 100%; max-width: 100%;">
    <MudCardHeader>
        <MudText Typo="Typo.h6">@Person.FirstName @Person.LastName</MudText>
    </MudCardHeader>

    <MudCardContent>
        <MudText>
            @if (PersonRole == RoleEnum.CastMembers.ToString())
            {
                @Person.FilmPerson.Count @(Person.FilmPerson.Count == 1 ? " film" : " films")
            }
            @if (PersonRole == RoleEnum.Directors.ToString())
            {
                @Person.Films.Count @(Person.Films.Count == 1 ? " film" : " films")
            }
        </MudText>
        
        <div class="my-4"></div>

        @{
            var ImageTitle = Person.LastName is null
                ? Person.FirstName
                : $"{Person.FirstName} {Person.LastName}";

            if (!string.IsNullOrWhiteSpace(Person.Description))
                ImageTitle += $" - {Person.Description}";
        }
        <MudLink Href="@($"/person/view/{Person.PersonId}")" Class="no-underline d-block">
            <ViewImageComponent ImageData="@Person.Picture"
                                ImageTitle="@ImageTitle" />
        </MudLink>
    </MudCardContent>

    <MudCardActions Class="d-flex flex-wrap" Style="gap: 8px;">
        <MudButton Variant="Variant.Filled" Color="Color.Primary" Href=@($"/person/view/{Person.PersonId}")>
            View
        </MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" Href=@($"/person/edit/{Person.PersonId}")>
            Edit
        </MudButton>
        @if (Person.Films?.Count == 0 && Person.FilmPerson.Count == 0)
        {            
            <MudButton Variant="Variant.Filled" Color="Color.Error" Href=@($"/person/delete/{Person.PersonId}")>
                Delete
            </MudButton>
        }
    </MudCardActions>
</MudCard>