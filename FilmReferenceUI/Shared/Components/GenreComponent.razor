<MudCard Class="ma-2 pa-2" Style="width: 100%; max-width: 350px;">
    <MudCardHeader>
        <MudText Typo="Typo.h6">@Genre.Name</MudText>
    </MudCardHeader>

    <MudCardContent>
        <MudText>@Genre.Films.Count @(Genre.Films.Count == 1 ? "film" : "films")</MudText>
        <br />
        @{
            var ImageTitle = string.IsNullOrWhiteSpace(Genre.Description)
                    ? Genre.Name
                    : $"{Genre.Name} - {Genre.Description}";
        }
        <MudButton Variant="Variant.Text"
            Color="Color.Primary"
            Href="@($"/genre/view/{Genre.GenreId}")"
            Class="p-0">
            <ViewImageComponent ImageData="Genre.Logo"
                                ImageTitle="@ImageTitle" />
        </MudButton>
    </MudCardContent>

    <MudCardActions Class="d-flex flex-wrap" Style="gap: 8px;">
        <MudButton Variant="Variant.Filled" Color="Color.Primary" Href=@($"/genre/view/{Genre.GenreId}")>
            View
        </MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" Href=@($"/genre/edit/{Genre.GenreId}")>
            Edit
        </MudButton>
        @if (Genre.Films.Count == 0)
        {            
            <MudButton Variant="Variant.Filled" Color="Color.Error" Href=@($"/genre/delete/{Genre.GenreId}")>
                Delete
            </MudButton>
        }
    </MudCardActions>
</MudCard>