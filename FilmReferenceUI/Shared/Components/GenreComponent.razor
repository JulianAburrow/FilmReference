<MudCard Class="ma-2" Style="width: 100%;">
    <MudCardHeader>
        <CardHeaderContent>
            <MudText Typo="Typo.h6">@Genre.Name</MudText>
            <MudText Typo="Typo.caption" Color="Color.Secondary">
                @Genre.Films.Count @(Genre.Films.Count == 1 ? "film" : "films")
            </MudText>
        </CardHeaderContent>
    </MudCardHeader>
    <MudCardContent Class="pt-0">
        @{
            var imageTitle = string.IsNullOrWhiteSpace(Genre.Description)
                ? Genre.Name
                : $"{Genre.Name} - {Genre.Description}";
        }
        <MudLink Href="@($"/genre/view/{Genre.GenreId}")" Class="no-underline d-block">
            <ViewImageComponent ImageData="Genre.Logo" ImageTitle="@imageTitle" />
        </MudLink>
    </MudCardContent>
    <MudCardActions Class="gap-2">
        <MudButton Variant="Variant.Filled"
                   Color="Color.Primary"
                   Size="Size.Small"
                   Href="@($"/genre/view/{Genre.GenreId}")">
            View
        </MudButton>
        <MudButton Variant="Variant.Outlined"
                   Color="Color.Primary"
                   Size="Size.Small"
                   Href="@($"/genre/edit/{Genre.GenreId}")">
            Edit
        </MudButton>
        @if (Genre.Films.Count == 0)
        {
            <MudButton Variant="Variant.Outlined"
                       Color="Color.Error"
                       Size="Size.Small"
                       Href="@($"/genre/delete/{Genre.GenreId}")">
                Delete
            </MudButton>
        }
    </MudCardActions>
</MudCard>
