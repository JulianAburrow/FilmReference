<MudCard Class="ma-2 pa-2" Style="width: 100%; max-width: 100%;">
    <MudCardHeader>
        <MudText Typo="Typo.h6">@Favourite.EntityName</MudText>
    </MudCardHeader>
    <MudCardContent>
        <MudLink
            Href="@($"/{Favourite.EntityTypeName}/View/{Favourite.EntityId}")"
            Class="no-underline d-block">
            @{
                var imageTitle = Favourite.EntityDescription is null
                    ? Favourite.EntityName
                    : $"{Favourite.EntityName} - {Favourite.EntityDescription}";
            }
            <ViewImageComponent ImageData="Favourite.EntityImage"
                                ImageTitle="@imageTitle" />
        </MudLink>
    </MudCardContent>
    <MudCardActions Class="d-flex flex-wrap" Style="gap: 8px;">
        <MudButton
            Variant="Variant.Filled"
            Color="Color.Primary"
            Size="Size.Small"
            Href=@($"/{Favourite.EntityTypeName}/view/{Favourite.EntityId}")>
            View
        </MudButton>
        <MudButton
            Variant="Variant.Filled"
            Color="Color.Error"
            Size="Size.Small"
            OnClick="RemoveFavourite">Unfavourite</MudButton>
    </MudCardActions>
</MudCard>