@inherits StudiosBasePageClass

<MudCardContent>

    <MudGrid>

        <MudItem xs="12" md="8">

            <MudTextField Label="Name"
                          @bind-Value="StudioDisplayModel.Name"
                          AutoFocus
                          OnlyValidateIfDirty="true" />

            <MudTextField Label="Description"
                          @bind-Value="StudioDisplayModel.Description" />

            <div class="my-4"></div>

            <MudFileUpload T="IBrowserFile"
                           FilesChanged="LocalUploadImage"
                           Accept="image/*"
                           Class="file-upload-button">
                    <MudButton HtmlTag="label"
                               Variant="Variant.Filled"
                               Color="Color.Primary"
                               StartIcon="@Icons.Material.Filled.FileUpload">
                        Upload File
                    </MudButton>
            </MudFileUpload>

            @if (StudioDisplayModel.Logo is not null)
            {
                <MudText Class="file-name-display">@ImageName</MudText>

                <div class="my-4" />

                <MudButton Variant="Variant.Filled"
                           Color="Color.Error"
                           OnClick="LocalRemoveImage"
                           Class="file-upload-button"
                           StartIcon="@Icons.Material.Filled.Delete">
                    Remove Image
                </MudButton>
            }

        </MudItem>

        <!-- RIGHT COLUMN: Studio logo -->
        <MudItem xs="12" md="4"
                 Class="d-flex justify-center align-center">

            <ViewImageComponent ImageData="StudioDisplayModel.Logo"
                                    ImageTitle="StudioDisplayModel.Name" />

        </MudItem>

    </MudGrid>

</MudCardContent>
