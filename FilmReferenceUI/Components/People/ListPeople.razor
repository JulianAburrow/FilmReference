@page "/people/listpeople"
@inherits PeopleBasePageClass

@if (PersonModels == null)
{
    <MudAlert Severity="Severity.Info" ContentAlignment="HorizontalAlignment.Center">Loading People...</MudAlert>
    return;
}

<a href="/person/create" class="btn btn-primary">Create Person</a>

<br />
<br />

@if (!PersonModels.Any())
{
    <p>No People found.</p>
    return;
}

<ListPeopleComponent PersonModels="PersonModels" />