@page "/film/delete/{FilmId:int}"
@inherits FilmsBasePageClass

<PageTitle>Delete Film</PageTitle>

@if (FilmModel == null)
{
    <MudAlert Severity="Severity.Info" ContentAlignment="HorizontalAlignment.Center">Loading Film...</MudAlert>
    return;
}
<MudAlert Severity="Severity.Warning" ContentAlignment="HorizontalAlignment.Center">
    <h4>Are you sure you want to delete this Film?</h4>
</MudAlert>

<ViewDeleteFilmComponent FilmModel="FilmModel" />

<br style="clear: both" />
<br />

<button class="btn btn-danger" @onclick="Delete">Delete</button> <a class="btn btn-primary" href="/films/listfilms">Cancel</a>
