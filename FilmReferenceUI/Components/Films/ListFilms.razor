@page "/films/listfilms"
@inherits FilmsBasePageClass

<PageTitle>Films</PageTitle>

@if(FilmModels == null)
{
    <MudAlert Severity="Severity.Info" ContentAlignment="HorizontalAlignment.Center">Loading Films...</MudAlert>
    return;
}

<a href="/film/create" class="btn btn-primary">Create Film</a>

<br />
<br />

@if (!FilmModels.Any())
{
    <p>No Films found.</p>
    return;
}

<ListFilmsComponent FilmModels="FilmModels" />