@page "/studios/liststudios"
@inherits StudiosBasePageClass

<PageTitle>Studios</PageTitle>

@if (StudioModels == null)
{
    <MudAlert Severity="Severity.Info" ContentAlignment="HorizontalAlignment.Center">Loading Studios...</MudAlert>
    return;
}

<a href="/studio/create" class="btn btn-primary">Create Studio</a>

<br />
<br />

@if (!StudioModels.Any())
{
    <p>No Studios found.</p>
    return;
}

<ListStudiosComponent StudioModels="StudioModels" />