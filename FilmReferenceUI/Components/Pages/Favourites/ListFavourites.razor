@page "/favourites/listfavourites"
@inherits FavouritesBasePageClass

<PageTitle>Favourites</PageTitle>

@if (FavouriteDisplayModels is null)
{
    <LoadingComponent />
    return;
}

@if (!FavouriteDisplayModels.Any())
{
    <p>No favourites found.</p>
    return;
}
else
{
    <h4>
        @FavouriteDisplayModels.Count()
        @(FavouriteDisplayModels.Count() == 1 ? "favourite" : "favourites")
        found
    </h4>
}

<ListFavouritesComponent FavouriteDisplayModels="FavouriteDisplayModels" OnRemoved="HandleRemoved" />

