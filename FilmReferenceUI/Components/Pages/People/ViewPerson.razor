@page "/person/view/{PersonId:int}"
@inherits PeopleBasePageClass

<PageTitle>View Person</PageTitle>

@if (!_isLoaded)
{
    <LoadingComponent DisplayValue=@(PersonModel.PersonId == 0 ? PersonNotFoundMessage : "Loading person...") IsLoading="@_isLoaded" />
    return;
}

<MudContainer Class="mt-1 px-8" MaxWidth="MaxWidth.False">
    <MudStack Spacing="4">

        <MudGrid>
            <MudItem xs="12">
                <MudCard>
                    <ViewDeletePersonComponent PersonModel="PersonModel" />
                    <MudCardActions Class="gap-2">
                        <MudButton Variant="Variant.Filled"
                                   Color="Color.Primary"
                                   Href="@($"/person/edit/{PersonModel.PersonId}")">
                            Edit
                        </MudButton>
                        @if (!PreventDeleting)
                        {
                            <MudButton Variant="Variant.Outlined"
                                       Color="Color.Error"
                                       Href="@($"/person/delete/{PersonModel.PersonId}")">
                                Delete
                            </MudButton>
                        }
                        @if (PersonModel.IsCastMember)
                        {
                            <MudButton Variant="Variant.Outlined"
                                       Color="Color.Default"
                                       OnClick="@(() => DoNavigation(RoleEnum.CastMembers))">
                                All Cast Members
                            </MudButton>
                        }
                        @if (PersonModel.IsDirector)
                        {
                            <MudButton Variant="Variant.Outlined"
                                       Color="Color.Default"
                                       OnClick="@(() => DoNavigation(RoleEnum.Directors))">
                                All Directors
                            </MudButton>
                        }
                    </MudCardActions>
                </MudCard>
            </MudItem>
        </MudGrid>

        @if (!FilmsStarredIn.Any() && !FilmsDirected.Any())
        {
            <LoadingComponent DisplayValue="No films found for this person." IsLoading="false" />
        }

        @if (FilmsStarredIn.Any())
        {
            <MudStack Spacing="2">
                <div class="d-flex align-center gap-3">
                    <MudText Typo="Typo.h6">
                        @FilmsStarredIn.Count @(FilmsStarredIn.Count == 1 ? "film" : "films") as cast member
                    </MudText>
                    @if (FilmsStarredIn.Count > 1)
                    {
                        <MudButton Variant="Variant.Outlined"
                                   Color="Color.Default"
                                   Size="Size.Small"
                                   StartIcon="@Icons.Material.Filled.SwapVert"
                                   OnClick="@(() => ResortList(FilmListToSortEnum.FilmsStarredIn))">
                            Reverse Sort
                        </MudButton>
                    }
                </div>
                <ListFilmsComponent FilmModels="@FilmsStarredIn" />
            </MudStack>
        }

        @if (FilmsDirected.Any())
        {
            <MudStack Spacing="2">
                <div class="d-flex align-center gap-3">
                    <MudText Typo="Typo.h6">
                        @FilmsDirected.Count @(FilmsDirected.Count == 1 ? "film" : "films") as director
                    </MudText>
                    @if (FilmsDirected.Count > 1)
                    {
                        <MudButton Variant="Variant.Outlined"
                                   Color="Color.Default"
                                   Size="Size.Small"
                                   StartIcon="@Icons.Material.Filled.SwapVert"
                                   OnClick="@(() => ResortList(FilmListToSortEnum.FilmsDirected))">
                            Reverse Sort
                        </MudButton>
                    }
                </div>
                <ListFilmsComponent FilmModels="@FilmsDirected" />
            </MudStack>
        }

    </MudStack>
</MudContainer>