@page "/person/view/{PersonId:int}"
@inherits PeopleBasePageClass

@if (PersonModel is null || PersonModel.FilmPerson is null)
{
	<LoadingComponent DisplayValue="Loading person" />
    return;
}

<MudGrid>
    <MudItem xs="12">
        <MudCard>
            <ViewDeletePersonComponent PersonModel="PersonModel" />
            <MudCardActions>

                <MudButton Variant="Variant.Filled"
                            Color="Color.Primary"
                            Href="@($"/person/edit/{PersonModel.PersonId}")">
                    Edit
                </MudButton>

                @if (!PreventDeleting)
                {
                    @:&nbsp;
                    <MudButton Variant="Variant.Filled"
                                Color="Color.Error"
                                Href="@($"/person/delete/{PersonModel.PersonId}")">
                        Delete
                    </MudButton>
                }
                &nbsp;
                @if (PersonModel.IsCastMember)
                {
                    <MudButton Variant="Variant.Filled"
                                Color="Color.Primary"
                                OnClick="@(() => DoNavigation(RoleEnum.CastMembers))">
                        All Cast Members
                    </MudButton>
                    @:&nbsp;
                }
                @if (PersonModel.IsDirector)
                {
                    <MudButton Variant="Variant.Filled"
                                Color="Color.Primary"
                                OnClick="@(() => DoNavigation(RoleEnum.Directors))">
                        All Directors
                    </MudButton>
                }
            </MudCardActions>
        </MudCard>
    </MudItem>
</MudGrid>

<br />
<br />

@if (!FilmsStarredIn.Any() && !FilmsDirected.Any())
{
    <h3>No films found for this person</h3>
    return;
}

@if (FilmsStarredIn.Any())
{
    <h3>@FilmsStarredIn.Count @(FilmsStarredIn.Count == 1 ? "film" : "films") as cast member</h3>

    @if (FilmsStarredIn.Count > 1)
    {
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="(() => ResortList(FilmListToSortEnum.FilmsStarredIn))">Reverse Sort Order</MudButton>
        <br />
        <br />
    }

    <ListFilmsComponent FilmModels="@FilmsStarredIn" />
}

@if (FilmsDirected.Any())
{
    <h3>@FilmsDirected.Count @(FilmsDirected.Count == 1 ? "film" : "films") as director</h3>

    @if (FilmsDirected.Count > 1)
    {
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="(() => ResortList(FilmListToSortEnum.FilmsDirected))">Reverse Sort Order</MudButton>
        <br />
        <br />
    }

    <ListFilmsComponent FilmModels="@FilmsDirected" />
}