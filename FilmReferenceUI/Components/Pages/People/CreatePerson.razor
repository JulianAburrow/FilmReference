@page "/person/create"
@inherits PeopleBasePageClass

<PageTitle>Create Person</PageTitle>

<MudContainer Class="mt-1 px-8" MaxWidth="MaxWidth.False">
    @if (ShowRoleError)
    {
        <MudAlert Severity="Severity.Error" Class="mb-3">
            Person must be either a cast member or a director or both.
        </MudAlert>
    }

    <EditForm Model="@PersonDisplayModel" OnValidSubmit="CreatePersonAsync">
        <DataAnnotationsValidator />
        <ValidationSummary />

        <MudGrid>
            <MudItem xs="12">
                <MudCard>
                    <CreateUpdatePersonComponent PersonDisplayModel="PersonDisplayModel" />
                    <MudCardActions Class="gap-2">
                        <MudButton Variant="Variant.Filled"
                                   Color="Color.Primary"
                                   ButtonType="ButtonType.Submit">
                            Create
                        </MudButton>
                        <MudButton Variant="Variant.Outlined"
                                   Color="Color.Default"
                                   Href="@($"/people/listpeople/{RoleEnum.CastMembers}")">
                            Cancel
                        </MudButton>
                    </MudCardActions>
                </MudCard>
            </MudItem>
        </MudGrid>
    </EditForm>
</MudContainer>
