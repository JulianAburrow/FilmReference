@page "/person/create"
@inherits PeopleBasePageClass

<PageTitle>Create Person</PageTitle>

@if (ShowRoleError)
{
    <p style="color: red">Person must be either a cast member or a director or both.</p>
}

<EditForm Model="@PersonDisplayModel" OnValidSubmit="CreatePersonAsync">
    <DataAnnotationsValidator />
    <ValidationSummary />

    <MudGrid>
        <MudItem xs="12">
            <MudCard>
                <CreateUpdatePersonComponent PersonDisplayModel="PersonDisplayModel" />
                <MudCardActions>
                    <MudButton Variant="Variant.Filled"
                               Color="Color.Primary"
                               ButtonType="ButtonType.Submit">
                        Create
                    </MudButton>

                    &nbsp;

                    <MudButton Variant="Variant.Filled"
                               Color="Color.Primary"
                               Href=@($"/people/listpeople/{RoleEnum.CastMembers}")>
                        Cancel
                    </MudButton>

                </MudCardActions>
            </MudCard>
        </MudItem>
    </MudGrid>
</EditForm>