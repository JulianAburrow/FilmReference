@page "/person/create"
@inherits PeopleBasePageClass

<EditForm Model="@PersonDisplayModel" OnValidSubmit="CreatePersonAsync">
    <DataAnnotationsValidator />
    <ValidationSummary />

    <MudGrid>
        <MudItem sm="7">
            <MudCard>
                <CreateUpdatePersonComponent PersonDisplayModel="PersonDisplayModel" />
                <MudCardActions>
                    <button type="submit" class="btn btn-primary">Create</button>
                    &nbsp;
                    <a href="/people/listpeople/castmembers" class="btn btn-primary">Cancel</a>
                </MudCardActions>
            </MudCard>
        </MudItem>
    </MudGrid>
</EditForm>