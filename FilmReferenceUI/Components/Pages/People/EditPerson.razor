@page "/person/edit/{PersonId:int}"
@inherits PeopleBasePageClass

<PageTitle>Edit Person</PageTitle>

@if (PersonDisplayModel is null)
{
	<LoadingComponent />
    return;
}

<EditForm Model="@PersonDisplayModel" OnValidSubmit="Update">
    <DataAnnotationsValidator />
    <ValidationSummary />

    <MudGrid>
        <MudItem sm="7">
            <MudCard>
                <MudCardContent>
                    <MudTextField Label="First Name" @bind-Value="PersonDisplayModel.FirstName" AutoFocus OnlyValidateIfDirty="true" />
                    <MudTextField Label="Last Name" @bind-Value="PersonDisplayModel.LastName" />
                    <MudTextField Label="Description" @bind-Value="PersonDisplayModel.Description" Lines="3" />
                    <MudCheckBox Label="Actor" @bind-Value="PersonDisplayModel.IsActor" />
                    <MudCheckBox Label="Director" @bind-Value="PersonDisplayModel.IsDirector" />
                    <ViewImageComponent ImageData="PersonDisplayModel.Picture" ImageTitle=@($"{PersonDisplayModel.FirstName} {PersonDisplayModel.LastName} Picture") />
                    <br />
                    <br />
                    <MudFileUpload T="IBrowserFile" FilesChanged="UploadFile">
                        <ActivatorContent>
                            <MudButton HtmlTag="label"
                                       Variant="Variant.Filled"
                                       Color="Color.Primary"
                                       StartIcon="@Icons.Material.Filled.FileUpload">
                                Upload File
                            </MudButton>
                        </ActivatorContent>
                    </MudFileUpload>
                    <br />
                    @ImageName
                    <br />
                    @if (PersonDisplayModel.Picture is not null || Image is not null)
                    {
                        <MudButton HtmlTag="label"
                                   OnClick="RemovePictureAndImage"
                                   Variant="Variant.Filled"
                                   Color="Color.Error">
                            Remove Image
                        </MudButton>
                    }
                </MudCardContent>
                <MudCardActions>
                    <button type="submit" class="btn btn-primary">Update</button>
                    &nbsp;
                    <a class="btn btn-primary" href="/people/listpeople">Cancel</a>
                </MudCardActions>
            </MudCard>
        </MudItem>
    </MudGrid>
</EditForm>