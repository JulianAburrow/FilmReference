@page "/person/edit/{PersonId:int}"
@inherits PeopleBasePageClass

<PageTitle>Edit Person</PageTitle>

@if (PersonDisplayModel is null)
{
	<LoadingComponent />
    return;
}

@if (ShowRoleError)
{
    <p style="color: red">Person must be either a cast member or a director or both.</p>
}

<EditForm Model="@PersonDisplayModel" OnValidSubmit="Update">
    <DataAnnotationsValidator />
    <ValidationSummary />

    <MudGrid>
        <MudItem sm="7">
            <MudCard>
                <CreateUpdatePersonComponent PersonDisplayModel="PersonDisplayModel" />
                <MudCardActions>
                    <button type="submit" class="btn btn-primary">Update</button>
                    &nbsp;
                    <a class="btn btn-primary" href="@($"/people/listpeople/{(PersonModel.IsCastMember ? "castmembers" : "directors")}")">Cancel</a>
                </MudCardActions>
            </MudCard>
        </MudItem>
    </MudGrid>
</EditForm>