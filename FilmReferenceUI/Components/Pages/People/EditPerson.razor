@page "/person/edit/{PersonId:int}"
@inherits PeopleBasePageClass

<PageTitle>Edit Person</PageTitle>

@if (!_isLoaded)
{
    <LoadingComponent DisplayValue="@(_entityNotFound
                                        ? PersonNotFoundMessage
                                        : LoadingPersonMessage)"
                      IsLoading="@(PersonModel.PersonId != 0)" />
    return;
}

<MudContainer Class="mt-1 px-8" MaxWidth="MaxWidth.False">
    @if (ShowRoleError)
    {
        <MudAlert Severity="Severity.Error" Class="mb-3">
            Person must be either a cast member or a director or both.
        </MudAlert>
    }

    <EditForm Model="@PersonDisplayModel" OnValidSubmit="Update">
        <DataAnnotationsValidator />
        <ValidationSummary />

        <MudGrid>
            <MudItem xs="12">
                <MudCard>
                    <CreateUpdatePersonComponent
                        PersonDisplayModel="PersonDisplayModel"
                        NationalityModels="NationalityModels" />
                    <MudCardActions Class="gap-2">
                        <MudButton Variant="Variant.Filled"
                                   Color="Color.Primary"
                                   ButtonType="ButtonType.Submit">
                            Update
                        </MudButton>
                        <MudButton Variant="Variant.Outlined"
                                   Color="Color.Default"
                                   Href="@($"/person/view/{PersonId}")">
                            Cancel
                        </MudButton>
                    </MudCardActions>
                </MudCard>
            </MudItem>
        </MudGrid>
    </EditForm>
</MudContainer>
