@page "/person/edit/{PersonId:int}"
@inherits PeopleBasePageClass

<PageTitle>Edit Person</PageTitle>

@if (PersonDisplayModel is null)
{
	<LoadingComponent />
    return;
}

@if (ShowRoleError)
{
    <p style="color: red">Person must be either a cast member or a director or both.</p>
}

<EditForm Model="@PersonDisplayModel" OnValidSubmit="Update">
    <DataAnnotationsValidator />
    <ValidationSummary />

    <MudGrid>
        <MudItem xs="12">
            <MudCard>
                <CreateUpdatePersonComponent PersonDisplayModel="PersonDisplayModel" />
                <MudCardActions>
                    <MudButton Variant="Variant.Filled"
                               Color="Color.Primary"
                               ButtonType="ButtonType.Submit">
                        Update
                    </MudButton>

                    &nbsp;

                    <MudButton Variant="Variant.Filled"
                               Color="Color.Primary"
                               Href="@($"/people/listpeople/{(PersonModel.IsCastMember ? "CastMembers" : "Directors")}")">
                        Cancel
                    </MudButton>

                </MudCardActions>
            </MudCard>
        </MudItem>
    </MudGrid>
</EditForm>