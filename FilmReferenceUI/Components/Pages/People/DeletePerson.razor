@page "/person/delete/{PersonId:int}"
@inherits PeopleBasePageClass

<PageTitle>Delete Person</PageTitle>

@if (!_isLoaded)
{
    <LoadingComponent DisplayValue="Loading person" />
    return;
}

<MudContainer Class="mt-1 px-8" MaxWidth="MaxWidth.False">
    <MudStack Spacing="3">

        @if (PreventDeleting)
        {
            <MudAlert Severity="Severity.Error" ContentAlignment="HorizontalAlignment.Center">
                This person cannot be deleted as they have films associated with them.
            </MudAlert>
            <div>
                <MudButton Variant="Variant.Outlined"
                           Color="Color.Default"
                           Href="@($"/person/view/{PersonId}")">
                    Back
                </MudButton>
            </div>
        }
        else
        {
            <MudAlert Severity="Severity.Warning" ContentAlignment="HorizontalAlignment.Center">
                Are you sure you want to delete this person?
            </MudAlert>

            <MudGrid>
                <MudItem xs="12">
                    <MudCard>
                        <ViewDeletePersonComponent PersonModel="PersonModel" />
                        <MudCardActions Class="gap-2">
                            <MudButton Variant="Variant.Filled"
                                       Color="Color.Error"
                                       StartIcon="@Icons.Material.Filled.Delete"
                                       OnClick="DeletePersonAsync">
                                Delete
                            </MudButton>
                            <MudButton Variant="Variant.Outlined"
                                       Color="Color.Default"
                                       Href="@($"/person/view/{PersonId}")">
                                Cancel
                            </MudButton>
                        </MudCardActions>
                    </MudCard>
                </MudItem>
            </MudGrid>
        }

    </MudStack>
</MudContainer>
