@page "/person/delete/{PersonId:int}"
@inherits PeopleBasePageClass

<PageTitle>Delete Genre</PageTitle>

@if (PersonModel is null)
{
    <MudAlert Severity="Severity.Info" ContentAlignment="HorizontalAlignment.Center">Loading Person...</MudAlert>
    return;
}

@if (PreventDeleting)
{
    <MudAlert Severity="Severity.Warning" ContentAlignment="HorizontalAlignment.Center">
        <h4>This Person cannot be deleted as they have films associated with them.</h4>
    </MudAlert>
    <br />
    <a href="/people/listpeople" class="btn btn-primary">Back to list</a>
    return;
}
else
{
    <MudAlert Severity="Severity.Warning" ContentAlignment="HorizontalAlignment.Center">
        <h4>Are you sure you want to delete this Person?</h4>
    </MudAlert>
}

<br />

<MudGrid>
    <MudItem sm="7">
        <MudCard>
            <ViewDeletePersonComponent PersonModel="PersonModel" />
            <MudCardActions>
                <button class="btn btn-danger" @onclick="DeletePersonAsync">Delete</button>
                &nbsp;
                <a class="btn btn-primary" href="/people/listpeople">Cancel</a>
            </MudCardActions>
        </MudCard>
    </MudItem>
</MudGrid>



