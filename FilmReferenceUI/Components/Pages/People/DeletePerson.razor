@page "/person/delete/{PersonId:int}"
@inherits PeopleBasePageClass

<PageTitle>Delete Person</PageTitle>

@if (PersonModel is null)
{
	<LoadingComponent DisplayValue="Loading person" />
    return;
}

@if (PreventDeleting)
{
    <MudAlert Severity="Severity.Warning" ContentAlignment="HorizontalAlignment.Center">
        <h4>This Person cannot be deleted as they have films associated with them.</h4>
    </MudAlert>
    <br />
    <MudButton Variant="Variant.Filled"
               Color="Color.Primary"
               Href="@($"/person/view/{PersonId}")">
        Cancel
    </MudButton>
    return;
}
else
{
    <MudAlert Severity="Severity.Warning" ContentAlignment="HorizontalAlignment.Center">
        <h4>Are you sure you want to delete this Person?</h4>
    </MudAlert>
}

<br />

<MudGrid>
    <MudItem xs="12">
        <MudCard>
            <ViewDeletePersonComponent PersonModel="PersonModel" />
            <MudCardActions>
                @if (!PreventDeleting)
                {
                    <MudButton Variant="Variant.Filled"
                               Color="Color.Error"
                               OnClick="DeletePersonAsync">
                        Delete
                    </MudButton>
                    @:&nbsp;
                }                
                <MudButton Variant="Variant.Filled"
                           Color="Color.Primary"
                           Href="@($"/person/view/{PersonId}")">
                    Cancel
                </MudButton>
            </MudCardActions>
        </MudCard>
    </MudItem>
</MudGrid>



