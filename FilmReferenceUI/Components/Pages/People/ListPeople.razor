@page "/people/listpeople/{PersonRole}"
@inherits PeopleBasePageClass

@if (AllPersonModels is null || FilteredPersonModels is null)
{
    <LoadingComponent />
    return;
}

<div class="sticky-div">
    <MudButton Variant="Variant.Filled"
               Color="Color.Primary"
               Href="/person/create">
        Create Person
    </MudButton>
</div>

<br />
<br />

<MudButton Variant="Variant.Filled"
           Color="@(NormaliseHelper.Normalised(Initial) == "all" ? Color.Error : Color.Primary)"
           OnClick="@(() => FilterPeople("All"))"
           Class="ma-1">
    All (@AllPersonModels.Count)
</MudButton>

@foreach (var letter in Enumerable.Range('A', 26).Select(c => ((char)c).ToString()))
{    
    <MudButton
        Variant="Variant.Filled"
               Color="@(NormaliseHelper.Normalised(Initial).ToLower() == NormaliseHelper.Normalised(letter) ? Color.Error : Color.Primary)"
        OnClick="(() => FilterPeople(letter))"
        Class="ma-1">
            @letter (@LetterCounts[letter])
    </MudButton>
}

<br />
<br />

@if (!FilteredPersonModels.Any())
{
    <h4>
        No people found@(Initial == "All" ? "" : $" with initial {Initial}")
    </h4>
	return;
}

<h4>
    @FilteredPersonModels.Count()
    @(FilteredPersonModels.Count() == 1 ? "person" : "people")
    found
    @(FilteredPersonModels.Count == AllPersonModels.Count
        ? ""
        : $"with initial {Initial}")
</h4>

@if (FilteredPersonModels.Count > 1)
{
    <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="ResortList">Reverse Sort Order</MudButton>
    <br />
    <br />
}

<ListPeopleComponent PersonModels="FilteredPersonModels" PersonRole="@PersonRole" />