@page "/people/listpeople/{PersonRole}"
@inherits PeopleBasePageClass

<PageTitle>View People</PageTitle>

@if (AllPersonModels is null || FilteredPersonModels is null)
{
    var displayValue = PersonRole == RoleEnum.CastMembers.ToString() ? "cast members..." : "directors...";
    <LoadingComponent DisplayValue=@($"Loading {displayValue}") />
    return;
}

<MudContainer Class="mt-1 px-8" MaxWidth="MaxWidth.False">

    <div class="sticky-div">
        <MudButton Variant="Variant.Filled"
                   Color="Color.Primary"
                   StartIcon="@Icons.Material.Filled.PersonAdd"
                   Href="/person/create">
            Create Person
        </MudButton>
    </div>

    <MudDivider Class="my-4" />

    <MudStack Spacing="3">

        <div class="d-flex flex-wrap gap-3">
            <MudButton Variant="@(NormaliseHelper.Normalised(Initial) == "all" ? Variant.Filled : Variant.Outlined)"
                       Color="@(NormaliseHelper.Normalised(Initial) == "all" ? Color.Secondary : Color.Default)"
                       OnClick="@(() => FilterPeople("All"))"
                       Size="Size.Small">
                All (@AllPersonModels.Count)
            </MudButton>

            @foreach (var letter in Enumerable.Range('A', 26).Select(c => ((char)c).ToString()))
            {
                <MudButton Variant="@(NormaliseHelper.Normalised(Initial).ToLower() == NormaliseHelper.Normalised(letter) ? Variant.Filled : Variant.Outlined)"
                           Color="@(NormaliseHelper.Normalised(Initial).ToLower() == NormaliseHelper.Normalised(letter) ? Color.Secondary : Color.Default)"
                           OnClick="@(() => FilterPeople(letter))"
                           Size="Size.Small">
                    @letter (@LetterCounts[letter])
                </MudButton>
            }
        </div>

        @if (!FilteredPersonModels.Any())
        {
            <LoadingComponent DisplayValue="@($"No people found{(Initial == "All" ? "" : $" with initial {Initial}")}")"
                              IsLoading="false" />
        }
        else
        {
            <div class="d-flex align-center gap-3">
                <MudText Typo="Typo.subtitle1">
                    @FilteredPersonModels.Count @(FilteredPersonModels.Count == 1 ? "person" : "people") found@(FilteredPersonModels.Count == AllPersonModels.Count ? "" : $" with initial {Initial}")
                </MudText>
                @if (FilteredPersonModels.Count > 1)
                {
                    <MudButton Variant="Variant.Outlined"
                               Color="Color.Default"
                               Size="Size.Small"
                               StartIcon="@Icons.Material.Filled.SwapVert"
                               OnClick="ResortList">
                        Reverse Sort
                    </MudButton>
                }
            </div>

            <ListPeopleComponent PersonModels="FilteredPersonModels" PersonRole="@PersonRole" />
        }

    </MudStack>

</MudContainer>
