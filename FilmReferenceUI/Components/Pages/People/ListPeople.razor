@page "/people/listpeople/{PersonRole}"
@inherits PeopleBasePageClass

<PageTitle>View People</PageTitle>

@if (AllPersonModels is null || FilteredPersonModels is null)
{
    var displayValue = PersonRole == RoleEnum.CastMembers.ToString()
        ? "cast members..."
        : "directors...";

    <LoadingComponent DisplayValue=@($"Loading {displayValue}") />
    return;
}

<MudContainer Class="mt-1 px-8" MaxWidth="MaxWidth.False">

    <div class="sticky-div">
        <MudButton Variant="Variant.Filled"
                   Color="Color.Primary"
                   StartIcon="@Icons.Material.Filled.PersonAdd"
                   Href="/person/create">
            Create Person
        </MudButton>
    </div>

    <MudDivider Class="my-4" />

    <MudStack Spacing="3">

        <!-- FILTER BAR (Unified) -->
        <MudStack Row="true" Spacing="2">

            @if (CurrentFilterMode == FilterMode.Initials)
            {
                <MudSelect T="string"
                        @bind-Value="Initial"
                        @bind-Value:after="(() => ApplyFilter(Initial))"
                        Label="Select First Initial"
                        FullWidth="false"
                        Style="width:250px;">
                <MudSelectItem T="string">
                    All
                </MudSelectItem>

                @foreach (var initial in Initials)
                {
                    <MudSelectItem T="string" Value="@initial">
                        @initial
                    </MudSelectItem>
                }
            </MudSelect>

            }
            else
            {
               <MudSelect T="string"
                            @bind-Value="Country"
                            @bind-Value:after="(() => ApplyFilter(Country))"
                            Label="Select Nationality"
                            FullWidth="false"
                            Style="width:250px;">
                    <MudSelectItem T="string">
                        All
                    </MudSelectItem>

                    @foreach (var nationality in Nationalities)
                    {
                        <MudSelectItem T="string" Value="@nationality.Name">
                            @nationality.Name
                        </MudSelectItem>
                    }
                </MudSelect>
            }

        </MudStack>

        <!-- RESULTS -->
        @if (!FilteredPersonModels.Any())
        {
            <LoadingComponent DisplayValue="@($"No people found")"
                              IsLoading="false" />
        }
        else
        {
            <div class="d-flex align-center gap-3">
                <MudText Typo="Typo.subtitle1">
                    @FilteredPersonModels.Count @(FilteredPersonModels.Count == 1 ? "person" : "people") found
                </MudText>

                @if (FilteredPersonModels.Count > 1)
                {
                    <MudButton Variant="Variant.Outlined"
                               Color="Color.Default"
                               Size="Size.Small"
                               StartIcon="@Icons.Material.Filled.SwapVert"
                               OnClick="ResortList">
                        Reverse Sort
                    </MudButton>
                }

                <MudButton Variant="Variant.Outlined"
                           Color="Color.Default"
                           Size="Size.Small"
                           OnClick="SwapInitialsForNationalities">
                    @InitialsOrNationalities
                </MudButton>
            </div>

            <ListPeopleComponent PersonModels="FilteredPersonModels"
                                 PersonRole="@PersonRole" />
        }

    </MudStack>

</MudContainer>
