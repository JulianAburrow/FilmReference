@page "/people/listpeople/{role}/{selectedfilter}"
@inherits PeopleBasePageClass

@if (PersonModels is null)
{
    <LoadingComponent />
    return;
}

<div class="sticky-div">
    <a href="/person/create" class="btn btn-primary">Create Person</a>
</div>

<br />
<br />

@foreach (var letter in Enumerable.Range('A', 26).Select(c => ((char)c).ToString()))
{    
    <MudButton
        Variant="Variant.Filled"
        Color="@(SelectedFilter.ToLower() == letter.ToLower() ? Color.Error : Color.Primary)"
        OnClick="(() => Navigate(letter))"
        Class="ma-1">
            @letter
        </MudButton>
}

<br />
<br />

@if (!PersonModels.Any())
{
	<p>No @(Role.ToLower() == RoleEnum.CastMembers.ToString().ToLower() ? "cast members" : "directors") found with a first name beginning with '@SelectedFilter'.</p>
	return;
}
else
{
    <p>@PersonModels.Count() @(PersonModels.Count() == 1 ? "person" : "people") found when filtering for '@SelectedFilter'.</p>
}

<ListPeopleComponent PersonModels="PersonModels" />