@page "/people/listpeople/{PersonRole}"
@inherits PeopleBasePageClass

<PageTitle>View People</PageTitle>

@if (AllPersonModels is null || FilteredPersonModels is null)
{
    var displayValue = PersonRole == RoleEnum.CastMembers.ToString()
        ? "cast members..."
        : "directors...";

    <LoadingComponent DisplayValue=@($"Loading {displayValue}") />
    return;
}

<MudContainer Class="mt-1 px-8" MaxWidth="MaxWidth.False">

    <div class="sticky-div">
        <MudButton Variant="Variant.Filled"
                   Color="Color.Primary"
                   StartIcon="@Icons.Material.Filled.PersonAdd"
                   Href="/person/create">
            Create Person
        </MudButton>
    </div>

    <MudDivider Class="my-4" />

    <MudStack Spacing="3">

        <!-- FILTER BAR (Unified) -->
        <div class="d-flex flex-wrap gap-3">

            <!-- ALL BUTTON -->
            <MudButton Variant="@(CurrentFilterMode == FilterMode.Initials
                                                    ? (NormaliseHelper.Normalised(Initial) == "all" ? Variant.Filled : Variant.Outlined)
                                                    : (NormaliseHelper.Normalised(Country) == "all" ? Variant.Filled : Variant.Outlined))"
                       Color="@(CurrentFilterMode == FilterMode.Initials
                                                    ? (NormaliseHelper.Normalised(Initial) == "all" ? Color.Secondary : Color.Default)
                                                    : (NormaliseHelper.Normalised(Country) == "all" ? Color.Secondary : Color.Default))"
                       OnClick="@(() => ApplyFilter("All"))"
                       Size="Size.Small">
                All (@AllPersonModels.Count)
            </MudButton>

            <!-- FILTER OPTIONS -->
            @foreach (var option in FilterOptions.Keys.OrderBy(k => k))
            {
                <MudButton Variant="@(CurrentFilterMode == FilterMode.Initials
                                                            ? (NormaliseHelper.Normalised(Initial) == NormaliseHelper.Normalised(option) ? Variant.Filled : Variant.Outlined)
                                                            : (NormaliseHelper.Normalised(Country) == NormaliseHelper.Normalised(option) ? Variant.Filled : Variant.Outlined))"
                           Color="@(CurrentFilterMode == FilterMode.Initials
                                                            ? (NormaliseHelper.Normalised(Initial) == NormaliseHelper.Normalised(option) ? Color.Secondary : Color.Default)
                                                            : (NormaliseHelper.Normalised(Country) == NormaliseHelper.Normalised(option) ? Color.Secondary : Color.Default))"
                           OnClick="@(() => ApplyFilter(option))"
                           Size="Size.Small">
                    @option (@FilterOptions[option])
                </MudButton>
            }
        </div>


        <!-- RESULTS -->
        @if (!FilteredPersonModels.Any())
        {
            <LoadingComponent DisplayValue="@($"No people found")"
                              IsLoading="false" />
        }
        else
        {
            <div class="d-flex align-center gap-3">
                <MudText Typo="Typo.subtitle1">
                    @FilteredPersonModels.Count @(FilteredPersonModels.Count == 1 ? "person" : "people") found
                </MudText>

                @if (FilteredPersonModels.Count > 1)
                {
                    <MudButton Variant="Variant.Outlined"
                               Color="Color.Default"
                               Size="Size.Small"
                               StartIcon="@Icons.Material.Filled.SwapVert"
                               OnClick="ResortList">
                        Reverse Sort
                    </MudButton>
                }

                <MudButton Variant="Variant.Outlined"
                           Color="Color.Default"
                           Size="Size.Small"
                           OnClick="SwapInitialsForNationalities">
                    @InitialsOrNationalities
                </MudButton>
            </div>

            <ListPeopleComponent PersonModels="FilteredPersonModels"
                                 PersonRole="@PersonRole" />
        }

    </MudStack>

</MudContainer>
