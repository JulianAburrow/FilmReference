@page "/films/listfilms"
@inherits FilmsBasePageClass

<PageTitle>Films</PageTitle>

@if(AllFilmModels is null || FilteredFilmModels is null || GenreModels is null)
{
    <LoadingComponent />
    return;
}

<div class="sticky-div">
    <a href="/film/create" class="btn btn-primary">Create Film</a>
</div>

<br /><br />

<MudButton Variant="Variant.Filled"
           Color="@(Normalised(Genre) == "all" ? Color.Error : Color.Primary)"
           OnClick="@(() => FilterFilms("All"))"
           Class="ma-1">
    All
</MudButton>

@foreach (var genreModel in GenreModels)
{
    <MudButton Variant="Variant.Filled"
               Color="@(Normalised(Genre) == Normalised(genreModel.Name) ? Color.Error : Color.Primary)"
               OnClick="@(() => FilterFilms(genreModel.Name))"
               Class="ma-1">
        @genreModel.Name
    </MudButton>
}

<br />
<br />

@if (!FilteredFilmModels.Any())
{
    <p>No films found.</p>
    return;
}
else
{
    <p>
        @FilteredFilmModels.Count()
        @(FilteredFilmModels.Count() == 1 ? "film" : "films")
        found in
        @(FilteredFilmModels.Count == AllFilmModels.Count
            ? "all genres"
            : $"genre {Genre}")
    </p>
}

<ListFilmsComponent FilmModels="FilteredFilmModels" />