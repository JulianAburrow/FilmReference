@page "/films/listfilms"

@inherits FilmsBasePageClass

<PageTitle>Films</PageTitle>

@if (AllFilmModels is null || FilteredFilmModels is null || GenreModels is null)
{
    <LoadingComponent />
    return;
}

<MudContainer Class="mt-1 px-8" MaxWidth="MaxWidth.False">

    <div class="sticky-div">
        <MudButton Variant="Variant.Filled"
                   Color="Color.Primary"
                   StartIcon="@Icons.Material.Filled.Add"
                   Href="/film/create">
            Create Film
        </MudButton>
    </div>

    <MudDivider Class="my-4" />

    <MudStack Spacing="3">

        <div class="d-flex flex-wrap gap-1">
            <MudButton Variant="@(NormaliseHelper.Normalised(Genre) == "all" ? Variant.Filled : Variant.Outlined)"
                       Color="@(NormaliseHelper.Normalised(Genre) == "all" ? Color.Secondary : Color.Default)"
                       OnClick="@(() => FilterFilms("All"))"
                       Size="Size.Small">
                All (@AllFilmModels.Count)
            </MudButton>

            @foreach (var genreModel in GenreModels)
            {
                <MudButton Variant="@(NormaliseHelper.Normalised(Genre) == NormaliseHelper.Normalised(genreModel.Name) ? Variant.Filled : Variant.Outlined)"
                           Color="@(NormaliseHelper.Normalised(Genre) == NormaliseHelper.Normalised(genreModel.Name) ? Color.Secondary : Color.Default)"
                           OnClick="@(() => FilterFilms(genreModel.Name))"
                           Size="Size.Small">
                    @genreModel.Name (@genreModel.Films.Count)
                </MudButton>
            }
        </div>

        @if (!FilteredFilmModels.Any())
        {
            <LoadingComponent DisplayValue="@($"No films found in genre {Genre}.")" IsLoading="false" />
        }
        else
        {
            <div class="d-flex align-center gap-3">
                <MudText Typo="Typo.subtitle1">
                    @FilteredFilmModels.Count @(FilteredFilmModels.Count == 1 ? "film" : "films") in @(Genre == "All" ? "all genres" : $"genre {Genre}")
                </MudText>
                @if (FilteredFilmModels.Count > 1)
                {
                    <MudButton Variant="Variant.Outlined"
                               Color="Color.Default"
                               Size="Size.Small"
                               StartIcon="@Icons.Material.Filled.SwapVert"
                               OnClick="ResortList">
                        Reverse Sort
                    </MudButton>
                }
            </div>

            <ListFilmsComponent FilmModels="FilteredFilmModels" />
        }

    </MudStack>

</MudContainer>
