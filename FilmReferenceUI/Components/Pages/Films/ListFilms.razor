@page "/films/listfilms/{Genre}"
@inherits FilmsBasePageClass

<PageTitle>Films</PageTitle>

@if(FilmModels is null || GenreModels is null)
{
    <LoadingComponent />
    return;
}

<div class="sticky-div">
    <a href="/film/create" class="btn btn-primary">Create Film</a>
</div>

<br /><br />
@foreach (var genreModel in GenreModels)
{
    <MudButton
        Variant="Variant.Filled"
        Color="@(Genre.ToLower().Replace(" ", "") == genreModel.Name.ToLower().Replace(" ", "") ? Color.Error : Color.Primary)"
        OnClick="@(() => Navigate(genreModel.Name))"
        Class="ma-1">
        @genreModel.Name
    </MudButton>
}

<br />
<br />

@if (!FilmModels.Any())
{
    <p>No films found"for the genre @FilmModels[0].Genre.Name").</p>
    return;
}
else
{
    <p>@FilmModels.Count() @(FilmModels.Count() == 1 ? "film" : "films") found the genre @FilmModels[0].Genre.Name</p>
}

<ListFilmsComponent FilmModels="FilmModels" />