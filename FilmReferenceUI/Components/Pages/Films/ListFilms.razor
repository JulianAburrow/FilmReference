@page "/films/listfilms"
@inherits FilmsBasePageClass

<PageTitle>Films</PageTitle>

@if(AllFilmModels is null || FilteredFilmModels is null || GenreModels is null)
{
    <LoadingComponent />
    return;
}

<div class="sticky-div">
    <MudButton Variant="Variant.Filled"
               Color="Color.Primary"
               Href="/film/create">
        Create Film
    </MudButton>
</div>

<br />
<br />

<MudButton Variant="Variant.Filled"
           Color="@(NormaliseHelper.Normalised(Genre) == "all" ? Color.Error : Color.Primary)"
           OnClick="@(() => FilterFilms("All"))"
           Class="ma-1">
    All (@AllFilmModels.Count)
</MudButton>

@foreach (var genreModel in GenreModels)
{
    <MudButton Variant="Variant.Filled"
               Color="@(NormaliseHelper.Normalised(Genre) == NormaliseHelper.Normalised(genreModel.Name) ? Color.Error : Color.Primary)"
               OnClick="@(() => FilterFilms(genreModel.Name))"
               Class="ma-1">
        @genreModel.Name (@genreModel.Films.Count)
    </MudButton>
}

<br />
<br />

@if (!FilteredFilmModels.Any())
{
    <h4>No films found in genre @Genre.</h4>
    return;
}

@{
    var count = FilteredFilmModels.Count;
    var filmWord = count == 1 ? "film" : "films";
    var genreText = Genre == "All"
        ? "all genres"
        : $"genre {Genre}";
}

<h4>@count @filmWord found in @genreText</h4>

@if (FilteredFilmModels.Count > 1)
{
    <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="ResortList">Reverse Sort Order</MudButton>
    <br />
    <br />
}

<ListFilmsComponent FilmModels="FilteredFilmModels" />