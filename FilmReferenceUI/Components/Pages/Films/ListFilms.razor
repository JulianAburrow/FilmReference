@page "/films/listfilms"
@inherits FilmsBasePageClass

<PageTitle>Films</PageTitle>

@if(FilmModels is null || GenreModels is null)
{
    <LoadingComponent />
    return;
}

<div class="sticky-div">
    <a href="/film/create" class="btn btn-primary">Create Film</a>
</div>

<br /><br />

<MudTooltip Text="@($"{FilmModels.Count} {(FilmModels.Count == 1 ? "film" : "films")} in total")">
    <MudButton Variant="Variant.Filled"
               Color="@(SelectedGenreId == 0 ? Color.Error : Color.Primary)"
               OnClick="@(() => FilterFilms(0))">
        All Films
    </MudButton>
</MudTooltip>

@foreach (var genreModel in GenreModels)
{
    <MudTooltip Text="@($"{GetFilmCountForGenre(genreModel.GenreId)} {(GetFilmCountForGenre(genreModel.GenreId) == 1 ? "film" : "films")} in this category")">
        <MudButton Variant="Variant.Filled"
                   Color="@(SelectedGenreId == genreModel.GenreId ? Color.Error : Color.Primary)"
                   OnClick="@(() => FilterFilms(genreModel.GenreId))"
                   Class="ma-1">
            @genreModel.Name
        </MudButton>
    </MudTooltip>
}

<br />
<br />

@{
    var SelectedGenreName = SelectedGenreId == 0 ? "All Genres" : GenreModels.FirstOrDefault(g => g.GenreId == SelectedGenreId)?.Name;
}

@if (!FilmModels.Any())
{
    <p>No Films found @(SelectedGenreId == 0 ? "in any genre" : "for the genre @SelectedGenreName").</p>
    return;
}
else
{

    var count = FilteredFilmModels.Count();
    var label = count == 1 ? "film" : "films";
    var genreText = SelectedGenreName == "All Genres"
        ? "in all genres"
        : $"for the genre {SelectedGenreName}";

    <p>@count @label found @genreText</p>
}

<ListFilmsComponent FilmModels="FilteredFilmModels" />