@page "/film/create"
@inherits FilmsBasePageClass

<PageTitle>Create Film</PageTitle>

@if (!_isLoaded)
{
    <LoadingComponent DisplayValue="@LoadingFilmMessage" />
    return;
}

<MudContainer Class="mt-1 px-8" MaxWidth="MaxWidth.False">
    <EditForm Model="@FilmDisplayModel" OnValidSubmit="CreateFilmAsync">
        <DataAnnotationsValidator />
        <ValidationSummary />

        <MudGrid>
            <MudItem xs="12">
                <MudCard>
                    <CreateUpdateFilmComponent FilmDisplayModel="FilmDisplayModel"
                                               GenreModels="GenreModelsLightweight"
                                               StudioModels="StudioModelsLightweight"
                                               ActorModels="CastMemberModelsLightweight"
                                               DirectorModels="DirectorModelsLightweight" />
                    <MudCardActions Class="gap-2">
                        <MudButton Variant="Variant.Filled"
                                   Color="Color.Primary"
                                   ButtonType="ButtonType.Submit">
                            Create
                        </MudButton>
                        <MudButton Variant="Variant.Outlined"
                                   Color="Color.Default"
                                   Href="/films/listfilms">
                            Cancel
                        </MudButton>
                    </MudCardActions>
                </MudCard>
            </MudItem>
        </MudGrid>
    </EditForm>
</MudContainer>
