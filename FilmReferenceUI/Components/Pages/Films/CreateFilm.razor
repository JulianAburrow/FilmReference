@page "/film/create"
@inherits FilmsBasePageClass

<PageTitle>Create Film</PageTitle>

@if (StudioModels is null || GenreModels is null || PersonModels is null)
{
    <MudAlert Severity="Severity.Info" ContentAlignment="HorizontalAlignment.Center">Loading...</MudAlert>
    return;
}

<EditForm Model="@FilmDisplayModel" OnValidSubmit="CreateFilmAsync">
    <DataAnnotationsValidator />
    <ValidationSummary />

    <MudGrid>
        <MudItem sm="7">
            <MudCard>
                <MudCardContent>
                    <MudTextField Label="Name" @bind-Value="FilmDisplayModel.Name" AutoFocus OnlyValidateIfDirty="true" />
                    <MudTextField Label="Description" @bind-Value="FilmDisplayModel.Description" Lines="3" />
                    <MudSelect T="int" Label="Genre" @bind-Value="@FilmDisplayModel.GenreId">
                        @foreach (var genreModel in GenreModels)
                        {
                            <MudSelectItem T="int" Value="@genreModel.GenreId">
                                @genreModel.Name
                            </MudSelectItem>
                        }
                    </MudSelect>
                    <MudSelect T="int" Label="Studio" @bind-Value="@FilmDisplayModel.StudioId">
                        @foreach (var studioModel in StudioModels)
                        {
                            <MudSelectItem T="int" Value="@studioModel.StudioId">
                                @studioModel.Name
                            </MudSelectItem>
                        }
                    </MudSelect>
                    <MudSelect T="int" Label="Director" @bind-Value="@FilmDisplayModel.DirectorId">
                        @foreach (var directorModel in DirectorModels)
                        {
                            <MudSelectItem T="int" Value="@directorModel.PersonId">
                                @directorModel.FirstName @directorModel.LastName
                            </MudSelectItem>
                        }
                    </MudSelect>
                    <br />
                    <MudFileUpload T="IBrowserFile" FilesChanged="UploadFile">
                        <ActivatorContent>
                            <MudButton HtmlTag="label"
                                       Variant="Variant.Filled"
                                       Color="Color.Primary"
                                       StartIcon="@Icons.Material.Filled.FileUpload">
                                Upload File
                            </MudButton>
                        </ActivatorContent>
                    </MudFileUpload>
                    @if (Image is not null)
                    {
                        <br />
                        @ImageName
                        <br />
                        <MudButton HtmlTag="label"
                                   OnClick="RemoveImage"
                                   Variant="Variant.Filled"
                                   Color="Color.Error">
                            Remove Image
                        </MudButton>
                    }
                    <br />
                    <br />
                    <MudSelect T="int"
                        Label="Actors"
                        @bind-Value="value"
                        @bind-SelectedValues="SelectedActors"
                        MultiSelection="true"
                        MultiSelectionTextFunc="@(new Func<List<string>, string>(GetMultiSelectionText))">
                        @foreach (var actorModel in ActorModels)
                        {
                            <MudSelectItem T="int" Value="@actorModel.PersonId">
                                @actorModel.FirstName @actorModel.LastName
                            </MudSelectItem>
                        }
                    </MudSelect>
                </MudCardContent>
                <MudCardActions>
                    <button type="submit" class="btn btn-primary">Create</button>
                    &nbsp;
                    <a href="/films/listfilms" class="btn btn-primary">Cancel</a>
                </MudCardActions>
            </MudCard>
        </MudItem>
    </MudGrid>
</EditForm>