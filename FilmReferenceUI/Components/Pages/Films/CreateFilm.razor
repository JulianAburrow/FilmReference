@page "/film/create"
@inherits FilmsBasePageClass

<PageTitle>Create Film</PageTitle>

@if (StudioModels is null || GenreModels is null || CastMemberModels is null || DirectorModels is null)
{
    <LoadingComponent />
    return;
}

<EditForm Model="@FilmDisplayModel" OnValidSubmit="CreateFilmAsync">
    <DataAnnotationsValidator />
    <ValidationSummary />

    <MudGrid>
        <MudItem xs="12">
            <MudCard>
                <CreateUpdateFilmComponent FilmDisplayModel="FilmDisplayModel"
                                           GenreModels="GenreModels"
                                           StudioModels="StudioModels"
                                           ActorModels="CastMemberModels"
                                           DirectorModels="DirectorModels" />
                <MudCardActions>

                    <MudButton Variant="Variant.Filled"
                               Color="Color.Primary"
                               ButtonType="ButtonType.Submit">
                        Create
                    </MudButton>

                    &nbsp;

                    <MudButton Variant="Variant.Filled"
                               Color="Color.Primary"
                               Href="/films/listfilms">
                        Cancel
                    </MudButton>

                </MudCardActions>

            </MudCard>
        </MudItem>
    </MudGrid>
</EditForm>