@page "/film/edit/{FilmId:int}"
@inherits FilmsBasePageClass

<PageTitle>Create Film</PageTitle>

@if (StudioModels is null || GenreModels is null || PersonModels is null)
{
    <LoadingComponent />
    return;
}

<EditForm Model="@FilmDisplayModel" OnValidSubmit="UpdateFilmAsync">
    <DataAnnotationsValidator />
    <ValidationSummary />

    <MudGrid>
        <MudItem sm="7">
            <MudCard>
                <MudCardContent>
                    <CreateUpdateFilmComponent FilmDisplayModel="FilmDisplayModel"
                                               GenreModels="GenreModels"
                                               StudioModels="StudioModels"
                                               DirectorModels="DirectorModels"
                                               ActorModels="CastMemberModels" />
                </MudCardContent>
                <MudCardActions>
                    <button type="submit" class="btn btn-primary">Update</button>
                    &nbsp;
                    <a href="/films/listfilms" class="btn btn-primary">Cancel</a>
                </MudCardActions>
            </MudCard>
        </MudItem>
    </MudGrid>
</EditForm>