@page "/film/edit/{FilmId:int}"
@inherits FilmsBasePageClass

<PageTitle>Edit Film</PageTitle>

@if (StudioModels is null || GenreModels is null || CastMemberModels is null || DirectorModels is null)
{
    <LoadingComponent />
    return;
}

<EditForm Model="@FilmDisplayModel" OnValidSubmit="UpdateFilmAsync">
    <DataAnnotationsValidator />
    <ValidationSummary />

    <MudGrid>
        <MudItem xs="12">
            <MudCard>
                <MudCardContent>
                    <CreateUpdateFilmComponent FilmDisplayModel="FilmDisplayModel"
                                               GenreModels="GenreModels"
                                               StudioModels="StudioModels"
                                               DirectorModels="DirectorModels"
                                               ActorModels="CastMemberModels" />
                </MudCardContent>
                <MudCardActions>
                    <MudButton Variant="Variant.Filled"
                               Color="Color.Primary"
                               ButtonType="ButtonType.Submit">
                        Update
                    </MudButton>

                    &nbsp;

                    <MudButton Variant="Variant.Filled"
                               Color="Color.Primary"
                               Href="@($"/film/view/{FilmId}")">
                        Cancel
                    </MudButton>

                </MudCardActions>
            </MudCard>
        </MudItem>
    </MudGrid>
</EditForm>