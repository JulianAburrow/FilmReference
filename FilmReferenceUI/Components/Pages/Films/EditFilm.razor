@page "/film/edit/{FilmId:int}"
@inherits FilmsBasePageClass

<PageTitle>Edit Film</PageTitle>

@if (!_isLoaded)
{
    <LoadingComponent DisplayValue=@(FilmModel.FilmId == 0 ? FilmNotFoundMessage : "Loading film...") IsLoading="@_isLoaded" />
    return;
}

<MudContainer Class="mt-1 px-8" MaxWidth="MaxWidth.False">
    <EditForm Model="@FilmDisplayModel" OnValidSubmit="UpdateFilmAsync">
        <DataAnnotationsValidator />
        <ValidationSummary />

        <MudGrid>
            <MudItem xs="12">
                <MudCard>
                    <CreateUpdateFilmComponent FilmDisplayModel="FilmDisplayModel"
                                               GenreModels="GenreModelsLightweight"
                                               StudioModels="StudioModelsLightweight"
                                               DirectorModels="DirectorModelsLightweight"
                                               ActorModels="CastMemberModelsLightweight" />
                    <MudCardActions Class="gap-2">
                        <MudButton Variant="Variant.Filled"
                                   Color="Color.Primary"
                                   ButtonType="ButtonType.Submit">
                            Update
                        </MudButton>
                        <MudButton Variant="Variant.Outlined"
                                   Color="Color.Default"
                                   Href="@($"/film/view/{FilmId}")">
                            Cancel
                        </MudButton>
                    </MudCardActions>
                </MudCard>
            </MudItem>
        </MudGrid>
    </EditForm>
</MudContainer>
