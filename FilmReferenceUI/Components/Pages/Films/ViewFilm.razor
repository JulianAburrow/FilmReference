@page "/film/view/{FilmId:int}"
@inherits FilmsBasePageClass

@if (FilmModel is null || FilmModel.FilmPerson is null)
{
    <LoadingComponent DisplayValue="Loading film" />
    return;
}

<MudGrid>
    <MudItem sm="7">
        <MudCard>
            <ViewDeleteFilmComponent FilmModel="FilmModel" />
            <MudCardActions>
                <a href="/film/edit/@FilmModel.FilmId" class="btn btn-primary">Edit</a>
                @if (!PreventDeleting)
                {
                    @:&nbsp;
                    <a href="/film/delete/@FilmModel.FilmId" class="btn btn-danger">Delete</a>
                }
                &nbsp;
                <a href="/films/listfilms" class="btn btn-primary">Back to list</a>
            </MudCardActions>
        </MudCard>
    </MudItem>
</MudGrid>

<br />
<br />

@if (!Cast.Any())
{
    <p>No stars found for this film</p>
    return;
}

<h3>@Cast.Count @(Cast.Count == 1 ? "star" : "stars")</h3>

<ListPeopleComponent PersonModels="@Cast" />