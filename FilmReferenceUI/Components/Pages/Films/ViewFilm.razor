@page "/film/view/{FilmId:int}"
@inherits FilmsBasePageClass

@if (FilmModel is null || FilmModel.FilmPerson is null)
{
    <LoadingComponent DisplayValue="Loading film" />
    return;
}

<MudGrid>
    <MudItem xs="12">
        <MudCard>
            <ViewDeleteFilmComponent FilmModel="FilmModel" />
            <MudCardActions>
                <MudButton Variant="Variant.Filled"
                           Color="Color.Primary"
                           Href="@($"/film/edit/{FilmModel.FilmId}")">
                    Edit
                </MudButton>

                @if (!PreventDeleting)
                {
                    @:&nbsp;
                    <MudButton Variant="Variant.Filled"
                               Color="Color.Error"
                               Href="@($"/film/delete/{FilmModel.FilmId}")">
                        Delete
                    </MudButton>
                }

                &nbsp;

                <MudButton Variant="Variant.Filled"
                           Color="Color.Primary"
                           Href="/films/listfilms">
                    All Films
                </MudButton>

            </MudCardActions>
        </MudCard>
    </MudItem>
</MudGrid>

<br />
<br />

@if (!Cast.Any())
{
    <h3>No cast members found for this film</h3>
    return;
}

@if (Cast.Count > 1)
{
    <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="ResortList">Reverse Sort Order</MudButton>
    <br />
    <br />
}

<h3>@Cast.Count cast @(Cast.Count == 1 ? "member" : "members")</h3>

<ListPeopleComponent PersonModels="@Cast" />