@page "/film/view/{FilmId:int}"
@inherits FilmsBasePageClass

<PageTitle>View Film</PageTitle>

@if (!_isLoaded)
{
    <LoadingComponent DisplayValue="Loading film" />
    return;
}

<MudContainer Class="mt-1 px-8" MaxWidth="MaxWidth.False">
    <MudStack Spacing="4">

        <MudGrid>
            <MudItem xs="12">
                <MudCard>
                    <ViewDeleteFilmComponent FilmModel="FilmModel" />
                    <MudCardActions Class="gap-2">
                        <MudButton Variant="Variant.Filled"
                                   Color="Color.Primary"
                                   Href="@($"/film/edit/{FilmModel.FilmId}")">
                            Edit
                        </MudButton>
                        @if (!PreventDeleting)
                        {
                            <MudButton Variant="Variant.Outlined"
                                       Color="Color.Error"
                                       Href="@($"/film/delete/{FilmModel.FilmId}")">
                                Delete
                            </MudButton>
                        }
                        <MudButton Variant="Variant.Outlined"
                                   Color="Color.Default"
                                   Href="/films/listfilms">
                            All Films
                        </MudButton>
                    </MudCardActions>
                </MudCard>
            </MudItem>
        </MudGrid>

        @if (!Cast.Any())
        {
            <LoadingComponent DisplayValue="No cast members found for this film." IsLoading="false" />
        }
        else
        {
            <div class="d-flex align-center gap-3">
                <MudText Typo="Typo.h6">
                    @Cast.Count cast @(Cast.Count == 1 ? "member" : "members")
                </MudText>
                @if (Cast.Count > 1)
                {
                    <MudButton Variant="Variant.Outlined"
                               Color="Color.Default"
                               Size="Size.Small"
                               StartIcon="@Icons.Material.Filled.SwapVert"
                               OnClick="ResortList">
                        Reverse Sort
                    </MudButton>
                }
            </div>

            <ListPeopleComponent PersonModels="@Cast" />
        }

    </MudStack>
</MudContainer>
