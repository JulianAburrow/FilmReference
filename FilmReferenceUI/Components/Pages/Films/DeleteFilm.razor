@page "/film/delete/{FilmId:int}"
@inherits FilmsBasePageClass

<PageTitle>Delete Film</PageTitle>

@if (FilmModel is null)
{
	<LoadingComponent DisplayValue="Loading film" />
    return;
}

<MudContainer Class="mt-1 px-8" MaxWidth="MaxWidth.False">
    <MudStack Spacing="3">

        <MudAlert Severity="Severity.Warning" ContentAlignment="HorizontalAlignment.Center">
            Are you sure you want to delete this film?
        </MudAlert>

        <MudGrid>
            <MudItem xs="12">
                <MudCard>
                    <ViewDeleteFilmComponent FilmModel="FilmModel" />
                    <MudCardActions Class="gap-2">
                        <MudButton Variant="Variant.Filled"
                                   Color="Color.Error"
                                   StartIcon="@Icons.Material.Filled.Delete"
                                   OnClick="DeleteFilmAsync">
                            Delete
                        </MudButton>
                        <MudButton Variant="Variant.Outlined"
                                   Color="Color.Default"
                                   Href="@($"/film/view/{FilmId}")">
                            Cancel
                        </MudButton>
                    </MudCardActions>
                </MudCard>
            </MudItem>
        </MudGrid>

    </MudStack>
</MudContainer>
