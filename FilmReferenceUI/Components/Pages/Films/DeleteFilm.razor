@page "/film/delete/{FilmId:int}"
@inherits FilmsBasePageClass

<PageTitle>Delete Film</PageTitle>

@if (FilmModel is null)
{
	<LoadingComponent DisplayValue="Loading film" />
    return;
}
<MudAlert Severity="Severity.Warning" ContentAlignment="HorizontalAlignment.Center">
    <h4>Are you sure you want to delete this Film?</h4>
</MudAlert>

<br />

<MudGrid>
    <MudItem xs="12">
        <MudCard>
            <ViewDeleteFilmComponent FilmModel="FilmModel" />
            <MudCardActions>
                <MudButton Variant="Variant.Filled"
                           Color="Color.Error"
                           OnClick="DeleteFilmAsync">
                    Delete
                </MudButton>

                &nbsp;

                <MudButton Variant="Variant.Filled"
                           Color="Color.Primary"
                           Href="@($"/film/view/{FilmId}")">
                    Cancel
                </MudButton>

            </MudCardActions>
        </MudCard>
    </MudItem>
</MudGrid>

