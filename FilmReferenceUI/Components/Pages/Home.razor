@page "/"
@inherits HomeBasePageClass

<PageTitle>Film Reference</PageTitle>

@if (RandomPerson is null)
{
    <LoadingComponent DisplayValue="Loading..." />
    return;
}

<h1>Film Reference</h1>

<h6>Welcome to your film reference application! Use this application to manage all your favoutite films.</h6>

<MudCard Class="ma-2 pa-2" Style="width: 100%; max-width: 350px;">
	<MudCardHeader>
		<MudText Typo="Typo.h6">@RandomPerson.FirstName @RandomPerson.LastName</MudText>
	</MudCardHeader>
	<MudCardContent>
		<a href="/person/view/@RandomPerson.PersonId">
			<ViewImageComponent ImageData="@RandomPerson.Picture"
                                ImageTitle="@($"{RandomPerson.FirstName} {RandomPerson.LastName} Photo")" />
        </a>
        <MudText Typo="Typo.subtitle2">@RandomPerson.FilmCount @(RandomPerson.FilmCount == 1 ? "film" : "films")</MudText>
	</MudCardContent>

	<MudCardActions Class="d-flex flex-wrap" Style="gap: 8px;">
		<MudButton Variant="Variant.Filled" Color="Color.Primary" Href=@($"/person/view/{RandomPerson.PersonId}")>
			View
		</MudButton>
	</MudCardActions>
</MudCard>

<h2>Search</h2>

<EditForm Model="@SearchModel" OnValidSubmit="DoSearch">
    <DataAnnotationsValidator />
    <ValidationSummary />

	<MudGrid>
		<MudItem sm="7">
			<MudCard>
				<MudCardContent>
					<MudSelect Label="Search For" T="int" @bind-Value="SearchModel.SearchType" @bind-Value:after="ClearSearchText">
						<MudSelectItem T="int" Value="SharedValues.PleaseSelectValue">
							@SharedValues.PleaseSelectText
						</MudSelectItem>
						@foreach (var searchOption in Enum.GetValues<SearchTypeEnum>())
						{
							<MudSelectItem T="int" Value="@((int)searchOption)">
								@searchOption
							</MudSelectItem>
						}
					</MudSelect>
					<MudTextField @ref="SearchTextBox" Label="Search For" @bind-Value="SearchModel.SearchText" />
				</MudCardContent>
				<MudCardActions>
					<button type="submit" class="btn btn-primary">Search</button>
					&nbsp;
					<button type="button" class="btn btn-danger" @onclick="ClearSearch">Clear Search</button>
				</MudCardActions>
			</MudCard>
		</MudItem>
	</MudGrid>
</EditForm>

@if (!SubmitClicked)
{
	return;
}

<br />

@if (SearchModel.SearchType == (int)SearchTypeEnum.Film)
{
    <a href="/film/create" class="btn btn-primary">Create Film</a>

	<br />
	<br />

	@if(FilmsFound.Count == 0)
	{
		<LoadingComponent DisplayValue="No films found" />
		return;
	}

	<h4>@FilmsFound.Count @(FilmsFound.Count == 1 ? "film" : "films") found matching search term '@SearchModel.SearchText'</h4>

	<ListFilmsComponent FilmModels="FilmsFound" />
}

@if (SearchModel.SearchType == (int)SearchTypeEnum.Genre)
{
	<a href="/genre/create" class="btn btn-primary">Create Genre</a>

	<br />
	<br />

	@if (GenresFound.Count == 0)
	{
		<LoadingComponent DisplayValue="No genres found" />		
		return;
	}

	<h4>@GenresFound.Count @(GenresFound.Count == 1 ? "genre" : "genres") found matching search term '@SearchModel.SearchText'</h4>

	<ListGenresComponent GenreModels="GenresFound" />
}

@if (SearchModel.SearchType == (int)SearchTypeEnum.Person)
{
	<a href="/person/create" class="btn btn-primary">Create Person</a>

	<br />
	<br />

	@if(PeopleFound.Count == 0)
	{
		<LoadingComponent DisplayValue="No people found" />
		return;
	}

	<h4>@PeopleFound.Count @(PeopleFound.Count == 1 ? "person" : "people") found matching search term '@SearchModel.SearchText'</h4>

	<ListPeopleComponent PersonModels="PeopleFound" />
}

@if (SearchModel.SearchType == (int)SearchTypeEnum.Studio)
{
	<a href="/studio/create" class="btn btn-primary">Create Studio</a>

	<br />
	<br />

	@if(StudiosFound.Count == 0)
	{
		<LoadingComponent DisplayValue="No studios found." />		
		return;
	}

	<h4>@StudiosFound.Count @(StudiosFound.Count == 1 ? "studio" : "studios") found matching search term '@SearchModel.SearchText'</h4>

	<ListStudiosComponent StudioModels="StudiosFound" />
}