@page "/studios/liststudios"
@inherits StudiosBasePageClass

<PageTitle>Studios</PageTitle>

@if (StudioModels is null)
{
	<LoadingComponent />
    return;
}

<div class="sticky-div">
    <MudButton Variant="Variant.Filled"
               Color="Color.Primary"
               Href="/studio/create">
        Create Studio
    </MudButton>
</div>

<br />
<br />

@if (!StudioModels.Any())
{
    <p>No Studios found.</p>
    return;
}

<h4>
    @StudioModels.Count()
    @(StudioModels.Count() == 1 ? "studio" : "studios")
    found
</h4>

@if (StudioModels.Count > 1)
{
    <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="ResortList">Reverse Sort Order</MudButton>
    <br />
    <br />
}

<ListStudiosComponent StudioModels="StudioModels" />