@page "/studios/liststudios"
@inherits StudiosBasePageClass

<PageTitle>Studios</PageTitle>

@if (StudioModels is null)
{
    <LoadingComponent />
    return;
}

<MudContainer Class="mt-1 px-8" MaxWidth="MaxWidth.False">

    <div class="sticky-div">
        <MudButton Variant="Variant.Filled"
                   Color="Color.Primary"
                   StartIcon="@Icons.Material.Filled.Add"
                   Href="/studio/create">
            Create Studio
        </MudButton>
    </div>

    <MudDivider Class="my-4" />

    <MudStack Spacing="3">

        @if (!StudioModels.Any())
        {
            <LoadingComponent DisplayValue="No studios found." IsLoading="false" />
        }
        else
        {
            <div class="d-flex align-center gap-3">
                <MudText Typo="Typo.subtitle1">
                    @StudioModels.Count() @(StudioModels.Count() == 1 ? "studio" : "studios") found
                </MudText>
                @if (StudioModels.Count > 1)
                {
                    <MudButton Variant="Variant.Outlined"
                               Color="Color.Default"
                               Size="Size.Small"
                               StartIcon="@Icons.Material.Filled.SwapVert"
                               OnClick="ResortList">
                        Reverse Sort
                    </MudButton>
                }
            </div>

            <ListStudiosComponent StudioModels="StudioModels" />
        }

    </MudStack>

</MudContainer>
