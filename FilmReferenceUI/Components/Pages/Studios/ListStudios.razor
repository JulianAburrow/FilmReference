@page "/studios/liststudios"
@inherits StudiosBasePageClass

<PageTitle>Studios</PageTitle>

@if (StudioModels is null)
{
	<LoadingComponent />
    return;
}

<div class="sticky-div">
    <MudButton Variant="Variant.Filled"
               Color="Color.Primary"
               Href="/studio/create">
        Create Studio
    </MudButton>
</div>

<br />
<br />

@if (!StudioModels.Any())
{
    <p>No Studios found.</p>
    return;
}
else
{
    <h4>
        @StudioModels.Count()
        @(StudioModels.Count() == 1 ? "studio" : "studios")
        found
    </h4>
}

<ListStudiosComponent StudioModels="StudioModels" />