@page "/studio/edit/{StudioId:int}"
@inherits StudiosBasePageClass

<PageTitle>Edit Studio</PageTitle>

@if (StudioDisplayModel is null)
{
	<LoadingComponent />
    return;
}

<EditForm Model="@StudioDisplayModel" OnValidSubmit="UpdateStudioAsync">
    <DataAnnotationsValidator />
    <ValidationSummary />

    <MudGrid>
        <MudItem xs="12">
            <MudCard>
                <CreateUpdateStudioComponent StudioDisplayModel="StudioDisplayModel" />
                <MudCardActions>
                    <MudButton Variant="Variant.Filled"
                               Color="Color.Primary"
                               ButtonType="ButtonType.Submit">
                        Update
                    </MudButton>
                    &nbsp;
                    <MudButton Variant="Variant.Filled"
                               Color="Color.Primary"
                               Href="@($"/studio/view/{StudioId}")">
                        Cancel
                    </MudButton>
                </MudCardActions>
            </MudCard>
        </MudItem>
    </MudGrid>
</EditForm>