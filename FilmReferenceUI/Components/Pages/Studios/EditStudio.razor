@page "/studio/edit/{StudioId:int}"
@inherits StudiosBasePageClass

<PageTitle>Edit Studio</PageTitle>

@if (StudioDisplayModel is null)
{
	<LoadingComponent />
    return;
}

<EditForm Model="@StudioDisplayModel" OnValidSubmit="UpdateStudioAsync">
    <DataAnnotationsValidator />
    <ValidationSummary />

    <MudGrid>
        <MudItem sm="7">
            <MudCard>
                <CreateUpdateStudioComponent StudioDisplayModel="StudioDisplayModel" />
                <MudCardActions>
                    <button type="submit" class="btn btn-primary">Update</button>
                    &nbsp;
                    <a class="btn btn-primary" href="/studios/liststudios">Cancel</a>
                </MudCardActions>
            </MudCard>
        </MudItem>
    </MudGrid>
</EditForm>