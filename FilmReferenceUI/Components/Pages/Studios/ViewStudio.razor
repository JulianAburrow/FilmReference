@page "/studio/view/{StudioId:int}"
@inherits StudiosBasePageClass

@if (StudioModel is null || StudioModel.Films is null)
{
	<LoadingComponent DisplayValue="Loading studio" />
    return;
}

<MudGrid>
    <MudItem xs="12">
        <MudCard>
            <ViewDeleteStudioComponent StudioModel="StudioModel" />
            <MudCardActions>

                <MudButton Variant="Variant.Filled"
                            Color="Color.Primary"
                            Href="@($"/studio/edit/{StudioModel.StudioId}")">
                    Edit
                </MudButton>

                @if (!PreventDeleting)
                {
                    @:&nbsp;
                    <MudButton Variant="Variant.Filled"
                                Color="Color.Error"
                                Href="@($"/studio/delete/{StudioModel.StudioId}")">
                        Delete
                    </MudButton>
                }

                &nbsp;
                <MudButton Variant="Variant.Filled"
                            Color="Color.Primary"
                            Href="/studios/liststudios">
                    All Studios
                </MudButton>

            </MudCardActions>

        </MudCard>
    </MudItem>
</MudGrid>

<br />
<br />

@if (!StudioModel.Films.Any())
{
    <h3>No films found for this studio</h3>
    return;
}

<h3>@StudioModel.Films.Count @(StudioModel.Films.Count == 1 ? "film" : "films")</h3>

<ListFilmsComponent FilmModels="@StudioModel.Films.ToList()" />