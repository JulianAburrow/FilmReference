@page "/studio/view/{StudioId:int}"
@inherits StudiosBasePageClass

@if (!_isLoaded)
{
    <LoadingComponent DisplayValue="Loading studio" />
    return;
}

<MudContainer Class="mt-1 px-8" MaxWidth="MaxWidth.False">
    <MudStack Spacing="4">

        <MudGrid>
            <MudItem xs="12">
                <MudCard>
                    <ViewDeleteStudioComponent StudioModel="StudioModel" />
                    <MudCardActions Class="gap-2">
                        <MudButton Variant="Variant.Filled"
                                   Color="Color.Primary"
                                   Href="@($"/studio/edit/{StudioModel.StudioId}")">
                            Edit
                        </MudButton>
                        @if (!PreventDeleting)
                        {
                            <MudButton Variant="Variant.Outlined"
                                       Color="Color.Error"
                                       Href="@($"/studio/delete/{StudioModel.StudioId}")">
                                Delete
                            </MudButton>
                        }
                        <MudButton Variant="Variant.Outlined"
                                   Color="Color.Default"
                                   Href="/studios/liststudios">
                            All Studios
                        </MudButton>
                    </MudCardActions>
                </MudCard>
            </MudItem>
        </MudGrid>

        @if (!StudioModel.Films.Any())
        {
            <LoadingComponent DisplayValue="No films found for this studio." IsLoading="false" />
        }
        else
        {
            <div class="d-flex align-center gap-3">
                <MudText Typo="Typo.h6">
                    @StudioModel.Films.Count @(StudioModel.Films.Count == 1 ? "film" : "films")
                </MudText>
                @if (StudioModel.Films.Count > 1)
                {
                    <MudButton Variant="Variant.Outlined"
                               Color="Color.Default"
                               Size="Size.Small"
                               StartIcon="@Icons.Material.Filled.SwapVert"
                               OnClick="ResortList">
                        Reverse Sort
                    </MudButton>
                }
            </div>

            <ListFilmsComponent FilmModels="@StudioModel.Films.ToList()" />
        }

    </MudStack>
</MudContainer>
