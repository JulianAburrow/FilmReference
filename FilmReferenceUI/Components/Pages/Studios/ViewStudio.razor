@page "/studio/view/{StudioId:int}"
@inherits StudiosBasePageClass

@if (StudioModel is null || StudioModel.Films is null)
{
	<LoadingComponent DisplayValue="Loading studio" />
    return;
}

<MudGrid>
    <MudItem sm="7">
        <MudCard>
            <ViewDeleteStudioComponent StudioModel="StudioModel" />
            <MudCardActions>
                <a href="/studio/edit/@StudioModel.StudioId" class="btn btn-primary">Edit</a>
                @if (!PreventDeleting)
                {
                    @:&nbsp;
                    <a href="/studio/delete/@StudioModel.StudioId" class="btn btn-danger">Delete</a>
                }
                &nbsp;
                <a href="/studios/liststudios" class="btn btn-primary">All Studios</a>
            </MudCardActions>
        </MudCard>
    </MudItem>
</MudGrid>

<br />
<br />

@if (!StudioModel.Films.Any())
{
    <p>No films found for this studio</p>
    return;
}

<h3>@StudioModel.Films.Count @(StudioModel.Films.Count == 1 ? "film" : "films")</h3>

<ListFilmsComponent FilmModels="@StudioModel.Films.ToList()" />