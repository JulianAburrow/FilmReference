@page "/studio/create"
@inherits StudiosBasePageClass

<PageTitle>Create Studio</PageTitle>

<MudContainer Class="mt-1 px-8" MaxWidth="MaxWidth.False">
    <EditForm Model="@StudioDisplayModel" OnValidSubmit="CreateStudioAsync">
        <DataAnnotationsValidator />
        <ValidationSummary />

        <MudGrid>
            <MudItem xs="12">
                <MudCard>
                    <CreateUpdateStudioComponent StudioDisplayModel="StudioDisplayModel" />
                    <MudCardActions Class="gap-2">
                        <MudButton Variant="Variant.Filled"
                                   Color="Color.Primary"
                                   ButtonType="ButtonType.Submit">
                            Create
                        </MudButton>
                        <MudButton Variant="Variant.Outlined"
                                   Color="Color.Default"
                                   Href="/studios/liststudios">
                            Cancel
                        </MudButton>
                    </MudCardActions>
                </MudCard>
            </MudItem>
        </MudGrid>
    </EditForm>
</MudContainer>
