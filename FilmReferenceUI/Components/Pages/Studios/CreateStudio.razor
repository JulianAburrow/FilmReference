@page "/studio/create"
@inherits StudiosBasePageClass

<PageTitle>Create Studio</PageTitle>

<EditForm Model="@StudioDisplayModel" OnValidSubmit="CreateStudioAsync">
    <DataAnnotationsValidator />
    <ValidationSummary />

    <MudGrid>
        <MudItem sm="7">
            <MudCard>
                <CreateUpdateStudioComponent StudioDisplayModel="StudioDisplayModel" />
                <MudCardActions>
                    <button type="submit" class="btn btn-primary">Create</button>
                    &nbsp;
                    <a href="/studios/liststudios" class="btn btn-primary">Cancel</a>
                </MudCardActions>
            </MudCard>
        </MudItem>
    </MudGrid>
</EditForm>