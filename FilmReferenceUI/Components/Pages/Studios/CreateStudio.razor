@page "/studio/create"
@inherits StudiosBasePageClass

<PageTitle>Create Studio</PageTitle>

<EditForm Model="@StudioDisplayModel" OnValidSubmit="CreateStudioAsync">
    <DataAnnotationsValidator />
    <ValidationSummary />

    <MudGrid>
        <MudItem xs="12">
            <MudCard>
                <CreateUpdateStudioComponent StudioDisplayModel="StudioDisplayModel" />
                <MudCardActions>
                    <MudButton Variant="Variant.Filled"
                               Color="Color.Primary"
                               ButtonType="ButtonType.Submit">
                        Create
                    </MudButton>
                    &nbsp;
                    <MudButton Variant="Variant.Filled"
                               Color="Color.Primary"
                               Href="/studios/liststudios">
                        Cancel
                    </MudButton>
                </MudCardActions>
            </MudCard>
        </MudItem>
    </MudGrid>
</EditForm>