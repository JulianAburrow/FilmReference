@page "/studio/delete/{StudioId:int}"
@inherits StudiosBasePageClass

<PageTitle>Delete Studio</PageTitle>

@if (StudioModel is null)
{
	<LoadingComponent DisplayValue="Loading studio" />
    return;
}

@if (PreventDeleting)
{
    <MudAlert Severity="Severity.Warning" ContentAlignment="HorizontalAlignment.Center">
        <h4>This Studio cannot be deleted as it is in use.</h4>
    </MudAlert>
    <br />
    <MudButton Variant="Variant.Filled"
               Color="Color.Primary"
               Href="@($"/studio/view/{StudioId}")">
        Cancel
    </MudButton>
    return;
}
else
{
    <MudAlert Severity="Severity.Warning" ContentAlignment="HorizontalAlignment.Center">
        <h4>Are you sure you want to delete this Studio?</h4>
    </MudAlert>
}

<br />

<MudGrid>
    <MudItem xs="12">
        <MudCard>
            <ViewDeleteStudioComponent StudioModel="StudioModel" />
            <MudCardActions>
                <MudButton Variant="Variant.Filled"
                           Color="Color.Error"
                           OnClick="DeleteStudioAsync">
                    Delete
                </MudButton>
                &nbsp;
                <MudButton Variant="Variant.Filled"
                           Color="Color.Primary"
                           Href="@($"/studio/view/{StudioId}")">
                    Cancel
                </MudButton>
            </MudCardActions>
        </MudCard>
    </MudItem>
</MudGrid>