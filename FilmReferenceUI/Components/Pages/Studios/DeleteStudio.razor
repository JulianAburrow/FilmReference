@page "/studio/delete/{StudioId:int}"
@inherits StudiosBasePageClass

<PageTitle>Delete Studio</PageTitle>

@if (!_isLoaded)
{
    <LoadingComponent DisplayValue=@(StudioModel.StudioId == 0 ? StudioNotFoundMessage : "Loading studio...") IsLoading="@_isLoaded" />
    return;
}

<MudContainer Class="mt-1 px-8" MaxWidth="MaxWidth.False">
    <MudStack Spacing="3">

        @if (PreventDeleting)
        {
            <MudAlert Severity="Severity.Error" ContentAlignment="HorizontalAlignment.Center">
                This studio cannot be deleted as it has films associated with it.
            </MudAlert>
            <div>
                <MudButton Variant="Variant.Outlined"
                           Color="Color.Default"
                           Href="@($"/studio/view/{StudioId}")">
                    Back
                </MudButton>
            </div>
        }
        else
        {
            <MudAlert Severity="Severity.Warning" ContentAlignment="HorizontalAlignment.Center">
                Are you sure you want to delete this studio?
            </MudAlert>

            <MudGrid>
                <MudItem xs="12">
                    <MudCard>
                        <ViewDeleteStudioComponent StudioModel="StudioModel" />
                        <MudCardActions Class="gap-2">
                            <MudButton Variant="Variant.Filled"
                                       Color="Color.Error"
                                       StartIcon="@Icons.Material.Filled.Delete"
                                       OnClick="DeleteStudioAsync">
                                Delete
                            </MudButton>
                            <MudButton Variant="Variant.Outlined"
                                       Color="Color.Default"
                                       Href="@($"/studio/view/{StudioId}")">
                                Cancel
                            </MudButton>
                        </MudCardActions>
                    </MudCard>
                </MudItem>
            </MudGrid>
        }

    </MudStack>
</MudContainer>
