@page "/studio/delete/{StudioId:int}"
@inherits StudiosBasePageClass

<PageTitle>Delete Studio</PageTitle>

@if (StudioModel == null)
{
    <MudAlert Severity="Severity.Info" ContentAlignment="HorizontalAlignment.Center">Loading Studio...</MudAlert>
    return;
}

@if (PreventDeleting)
{
    <MudAlert Severity="Severity.Warning" ContentAlignment="HorizontalAlignment.Center">
        <h4>This Studio cannot be deleted as it is in use.</h4>
    </MudAlert>
    <br />
    <a href="/studios/liststudios" class="btn btn-primary">Back to list</a>
    return;
}
else
{
    <MudAlert Severity="Severity.Warning" ContentAlignment="HorizontalAlignment.Center">
        <h4>Are you sure you want to delete this Studio?</h4>
    </MudAlert>
}

<br />

<MudGrid>
    <MudItem sm="7">
        <MudCard>
            <ViewDeleteStudioComponent StudioModel="StudioModel" />
            <MudCardActions>
                <button class="btn btn-danger" @onclick="DeleteStudioAsync">Delete</button>
                &nbsp;
                <a class="btn btn-primary" href="/studios/liststudios">Cancel</a>
            </MudCardActions>
        </MudCard>
    </MudItem>
</MudGrid>