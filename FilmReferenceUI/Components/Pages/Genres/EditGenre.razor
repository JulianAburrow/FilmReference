@page "/genre/edit/{GenreId:int}"
@inherits GenresBasePageClass

<PageTitle>Edit Genre</PageTitle>

@if (!_isLoaded)
{
    <LoadingComponent DisplayValue="@(_entityNotFound
                                        ? GenreNotFoundMessage
                                        : LoadingGenreMessage)"
                      IsLoading="@(GenreModel.GenreId != 0)" />
    return;
}

<MudContainer Class="mt-1 px-8" MaxWidth="MaxWidth.False">
    <EditForm Model="@GenreDisplayModel" OnValidSubmit="Update">
        <DataAnnotationsValidator />
        <ValidationSummary />

        <MudGrid>
            <MudItem xs="12">
                <MudCard>
                    <CreateUpdateGenreComponent GenreDisplayModel="@GenreDisplayModel" />
                    <MudCardActions Class="gap-2">
                        <MudButton Variant="Variant.Filled"
                                   Color="Color.Primary"
                                   ButtonType="ButtonType.Submit">
                            Update
                        </MudButton>
                        <MudButton Variant="Variant.Outlined"
                                   Color="Color.Default"
                                   Href="@($"/genre/view/{GenreId}")">
                            Cancel
                        </MudButton>
                    </MudCardActions>
                </MudCard>
            </MudItem>
        </MudGrid>
    </EditForm>
</MudContainer>
