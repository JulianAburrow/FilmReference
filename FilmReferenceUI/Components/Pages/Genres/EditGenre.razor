@page "/genre/edit/{GenreId:int}"
@inherits GenresBasePageClass

<PageTitle>Edit Genre</PageTitle>

@if (GenreDisplayModel is null)
{
	<LoadingComponent />
    return;
}

<EditForm Model="@GenreDisplayModel" OnValidSubmit="Update">
    <DataAnnotationsValidator />
    <ValidationSummary />

    <MudGrid>
        <MudItem sm="7">
            <MudCard>
                <CreateUpdateGenreComponent GenreDisplayModel="@GenreDisplayModel" />
                <MudCardActions>
                    <button type="submit" class="btn btn-primary">Update</button>
                    &nbsp;
                    <a class="btn btn-primary" href="/genres/listgenres">Cancel</a>
                </MudCardActions>
            </MudCard>
        </MudItem>
    </MudGrid>
</EditForm>