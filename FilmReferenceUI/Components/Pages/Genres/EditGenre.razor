@page "/genre/edit/{GenreId:int}"
@inherits GenresBasePageClass

<PageTitle>Edit Genre</PageTitle>

@if (GenreDisplayModel is null)
{
	<LoadingComponent />
    return;
}

<EditForm Model="@GenreDisplayModel" OnValidSubmit="Update">
    <DataAnnotationsValidator />
    <ValidationSummary />

    <MudGrid>
        <MudItem xs="12">
            <MudCard>
                <CreateUpdateGenreComponent GenreDisplayModel="@GenreDisplayModel" />
                <MudCardActions>
                    <MudButton Variant="Variant.Filled"
                               Color="Color.Primary"
                               ButtonType="ButtonType.Submit">
                        Update
                    </MudButton>

                    &nbsp;

                    <MudButton Variant="Variant.Filled"
                               Color="Color.Primary"
                               Href="@($"/genre/view/{GenreId}")">
                        Cancel
                    </MudButton>

                </MudCardActions>
            </MudCard>
        </MudItem>
    </MudGrid>
</EditForm>