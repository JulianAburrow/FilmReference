@page "/genres/listgenres"
@inherits GenresBasePageClass

<PageTitle>Genres</PageTitle>

@if (GenreModels is null)
{
    <LoadingComponent />
    return;
}

<div class="sticky-div">
    <a href="/genre/create" class="btn btn-primary">Create Genre</a>
</div>

<br />
<br />

@if (!GenreModels.Any())
{
    <p>No Genres found.</p>
    return;
}
else
{
    <h4>
        @GenreModels.Count()
        @(GenreModels.Count() == 1 ? "genre" : "genres")
        found
    </h4>
}

<ListGenresComponent GenreModels="GenreModels" />