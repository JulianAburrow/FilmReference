@page "/genres/listgenres"
@inherits GenresBasePageClass

<PageTitle>Genres</PageTitle>

@if (GenreModels is null)
{
    <LoadingComponent />
    return;
}

<div class="sticky-div">
    <MudButton Variant="Variant.Filled"
               Color="Color.Primary"
               Href="/genre/create">
        Create Genre
    </MudButton>
</div>

<br />
<br />

@if (!GenreModels.Any())
{
    <p>No Genres found.</p>
    return;
}

<h4>
    @GenreModels.Count()
    @(GenreModels.Count() == 1 ? "genre" : "genres")
    found
</h4>

@if (GenreModels.Count > 1)
{
    <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="ResortList">Reverse Sort Order</MudButton>
    <br />
    <br />
}

<ListGenresComponent GenreModels="GenreModels" />