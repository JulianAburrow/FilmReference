@page "/genres/listgenres"
@inherits GenresBasePageClass

<PageTitle>Genres</PageTitle>

@if (GenreModels is null)
{
    <LoadingComponent />
    return;
}

<MudContainer Class="mt-1 px-8" MaxWidth="MaxWidth.False">

    <div class="sticky-div">
        <MudButton Variant="Variant.Filled"
                   Color="Color.Primary"
                   StartIcon="@Icons.Material.Filled.Add"
                   Href="/genre/create">
            Create Genre
        </MudButton>
    </div>

    <MudDivider Class="my-4" />

    <MudStack Spacing="3">

        @if (!GenreModels.Any())
        {
            <LoadingComponent DisplayValue="No genres found." IsLoading="false" />
        }
        else
        {
            <div class="d-flex align-center gap-3">
                <MudText Typo="Typo.subtitle1">
                    @GenreModels.Count() @(GenreModels.Count() == 1 ? "genre" : "genres") found
                </MudText>
                @if (GenreModels.Count > 1)
                {
                    <MudButton Variant="Variant.Outlined"
                               Color="Color.Default"
                               Size="Size.Small"
                               StartIcon="@Icons.Material.Filled.SwapVert"
                               OnClick="ResortList">
                        Reverse Sort
                    </MudButton>
                }
            </div>

            <ListGenresComponent GenreModels="GenreModels" />
        }

    </MudStack>

</MudContainer>
