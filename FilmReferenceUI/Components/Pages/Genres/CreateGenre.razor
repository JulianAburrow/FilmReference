@page "/genre/create"
@inherits GenresBasePageClass

<PageTitle>Create Genre</PageTitle>

<EditForm Model="@GenreDisplayModel" OnValidSubmit="CreateGenreAsync">
    <DataAnnotationsValidator />
    <ValidationSummary />

    <MudGrid>
        <MudItem xs="12">
            <MudCard>
                <CreateUpdateGenreComponent GenreDisplayModel="@GenreDisplayModel" />
                <MudCardActions>
                    <MudButton Variant="Variant.Filled"
                               Color="Color.Primary"
                               ButtonType="ButtonType.Submit">
                        Create
                    </MudButton>

                    &nbsp;

                    <MudButton Variant="Variant.Filled"
                               Color="Color.Primary"
                               Href="/genres/listgenres">
                        Cancel
                    </MudButton>

                </MudCardActions>
            </MudCard>
        </MudItem>
    </MudGrid>
</EditForm>