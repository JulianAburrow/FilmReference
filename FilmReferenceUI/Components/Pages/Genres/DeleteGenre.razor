@page "/genre/delete/{GenreId:int}"
@inherits GenresBasePageClass

<PageTitle>Delete Genre</PageTitle>

@if (GenreModel is null)
{
    <LoadingComponent DisplayValue="Loading genre" />
    return;
}

@if (PreventDeleting)
{
    <MudAlert Severity="Severity.Warning" ContentAlignment="HorizontalAlignment.Center">
        <h4>This Genre cannot be deleted as it is in use.</h4>
    </MudAlert>
    <br />
    <a href = "/genre/view/@GenreId" class="btn btn-primary">Cancel</a>
    return;
}
else
{
    <MudAlert Severity="Severity.Warning" ContentAlignment="HorizontalAlignment.Center">
        <h4>Are you sure you want to delete this Genre?</h4>
    </MudAlert>
}

<br />

<MudGrid>
    <MudItem sm="7">
        <MudCard>
            <ViewDeleteGenreComponent GenreModel="GenreModel" />
            <MudCardActions>
                <button class="btn btn-danger" @onclick="DeleteGenreAsync">Delete</button>
                &nbsp;
                <a class="btn btn-primary" href="/genre/view/@GenreId">Cancel</a>
            </MudCardActions>
        </MudCard>
    </MudItem>
</MudGrid>

