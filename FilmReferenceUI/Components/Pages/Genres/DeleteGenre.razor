@page "/genre/delete/{GenreId:int}"
@inherits GenresBasePageClass

<PageTitle>Delete Genre</PageTitle>

@if (!_isLoaded)
{
    <LoadingComponent DisplayValue="Loading genre" />
    return;
}

<MudContainer Class="mt-16 px-8" MaxWidth="MaxWidth.False">
    <MudStack Spacing="3">

        @if (PreventDeleting)
        {
            <MudAlert Severity="Severity.Error" ContentAlignment="HorizontalAlignment.Center">
                This genre cannot be deleted as it has films associated with it.
            </MudAlert>
            <div>
                <MudButton Variant="Variant.Outlined"
                           Color="Color.Default"
                           Href="@($"/genre/view/{GenreId}")">
                    Back
                </MudButton>
            </div>
        }
        else
        {
            <MudAlert Severity="Severity.Warning" ContentAlignment="HorizontalAlignment.Center">
                Are you sure you want to delete this genre?
            </MudAlert>

            <MudGrid>
                <MudItem xs="12">
                    <MudCard>
                        <ViewDeleteGenreComponent GenreModel="GenreModel" />
                        <MudCardActions Class="gap-2">
                            <MudButton Variant="Variant.Filled"
                                       Color="Color.Error"
                                       StartIcon="@Icons.Material.Filled.Delete"
                                       OnClick="DeleteGenreAsync">
                                Delete
                            </MudButton>
                            <MudButton Variant="Variant.Outlined"
                                       Color="Color.Default"
                                       Href="@($"/genre/view/{GenreId}")">
                                Cancel
                            </MudButton>
                        </MudCardActions>
                    </MudCard>
                </MudItem>
            </MudGrid>
        }

    </MudStack>
</MudContainer>
