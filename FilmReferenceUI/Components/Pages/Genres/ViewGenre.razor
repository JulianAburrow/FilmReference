@page "/genre/view/{GenreId:int}"
@inherits GenresBasePageClass

@if (GenreModel is null || GenreModel.Films is null)
{
	<LoadingComponent DisplayValue="Loading genre" />
    return;
}

<MudGrid>
    <MudItem xs="12">
        <MudCard>
            <ViewDeleteGenreComponent GenreModel="GenreModel" />
            <MudCardActions>

                <MudButton Variant="Variant.Filled"
                            Color="Color.Primary"
                            Href="@($"/genre/edit/{GenreModel.GenreId}")">
                    Edit
                </MudButton>

                @if (!PreventDeleting)
                {
                    @:&nbsp;
                    <MudButton Variant="Variant.Filled"
                                Color="Color.Error"
                                Href="@($"/genre/delete/{GenreModel.GenreId}")">
                        Delete
                    </MudButton>
                }

                &nbsp;
                <MudButton Variant="Variant.Filled"
                            Color="Color.Primary"
                            Href="/genres/listgenres">
                    All Genres
                </MudButton>

            </MudCardActions>

        </MudCard>
    </MudItem>
</MudGrid>

<br />
<br />

@if (!GenreModel.Films.Any())
{
    <h3>No films found for this genre</h3>
    return;
}

<h3>@GenreModel.Films.Count @(GenreModel.Films.Count == 1 ? "film" : "films")</h3>

@if (GenreModel.Films.Count > 1)
{
    <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="ResortList">Reverse Sort Order</MudButton>
    <br />
    <br />
}

<ListFilmsComponent FilmModels="GenreModel.Films.ToList()" />