@page "/genre/view/{GenreId:int}"
@inherits GenresBasePageClass

<PageTitle>View Genre</PageTitle>

@if (!_isLoaded)
{
    <LoadingComponent DisplayValue="@(_entityNotFound
                                        ? GenreNotFoundMessage
                                        : LoadingGenreMessage)"
                      IsLoading="@(GenreModel.GenreId != 0)" />
    return;
}

<MudContainer Class="mt-1 px-8" MaxWidth="MaxWidth.False">
    <MudStack Spacing="4">

        <MudGrid>
            <MudItem xs="12">
                <MudCard>
                    <ViewDeleteGenreComponent GenreModel="GenreModel" />
                    <MudCardActions Class="gap-2">
                        <MudButton Variant="Variant.Filled"
                                   Color="Color.Primary"
                                   Href="@($"/genre/edit/{GenreModel.GenreId}")">
                            Edit
                        </MudButton>
                        @if (!PreventDeleting)
                        {
                            <MudButton Variant="Variant.Outlined"
                                       Color="Color.Error"
                                       Href="@($"/genre/delete/{GenreModel.GenreId}")">
                                Delete
                            </MudButton>
                        }
                        <MudButton Variant="Variant.Outlined"
                                   Color="Color.Default"
                                   Href="/genres/listgenres">
                            All Genres
                        </MudButton>
                    </MudCardActions>
                </MudCard>
            </MudItem>
        </MudGrid>

        @if (!GenreModel.Films.Any())
        {
            <LoadingComponent DisplayValue="No films found for this genre." IsLoading="false" />
        }
        else
        {
            <div class="d-flex align-center gap-3">
                <MudText Typo="Typo.h6">
                    @GenreModel.Films.Count @(GenreModel.Films.Count == 1 ? "film" : "films")
                </MudText>
                @if (GenreModel.Films.Count > 1)
                {
                    <MudButton Variant="Variant.Outlined"
                               Color="Color.Default"
                               Size="Size.Small"
                               StartIcon="@Icons.Material.Filled.SwapVert"
                               OnClick="ResortList">
                        Reverse Sort
                    </MudButton>
                }
            </div>

            <ListFilmsComponent FilmModels="GenreModel.Films.ToList()" />
        }

    </MudStack>
</MudContainer>
